---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutPageContent from '../components/AboutPageContent.astro';
import { getPage } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

const { data } = await getPage('about.md');
const seo = (data.page.seo ?? {}) as any;
const title = seo.title || `${data.page.title} — Juan Vistro`;
const description = seo.description || data.page.summary || data.page.title;
---

<BaseLayout title={title} description={description} image={seo.socialImage} imageAlt={seo.socialImageAlt} ogTitle={data.page.title}>
  <TinaIsland name="about" wrapper={islands.about.wrapper} primary>
    <AboutPageContent data={data.page} />
  </TinaIsland>
</BaseLayout>
