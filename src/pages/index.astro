---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HomePageContent from '../components/HomePageContent.astro';
import { getHomepage } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';
import BaseLayout from '../layouts/BaseLayout.astro';

const { data, work, projects, resume } = await getHomepage();
---

<BaseLayout title="Juan Vistro — Engineering & leadership" description={data.page.summary || data.page.title} editorial>
  <TinaIsland name="home" wrapper={islands.home.wrapper} primary><HomePageContent data={data.page} work={work} projects={projects} resume={resume} /></TinaIsland>
</BaseLayout>
