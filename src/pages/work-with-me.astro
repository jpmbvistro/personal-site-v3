---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkWithMePageContent from '../components/WorkWithMePageContent.astro';
import { getPage } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

const { data } = await getPage('work-with-me.md');
---

<BaseLayout title={`${data.page.title} — Juan Vistro`} description={data.page.summary || data.page.title}>
  <TinaIsland name="workWithMe" wrapper={islands.workWithMe.wrapper} primary>
    <WorkWithMePageContent data={data.page} />
  </TinaIsland>
</BaseLayout>
