---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { getArticle, getPublishedArticles } from '../../lib/tina/data';

export async function getStaticPaths() {
  return (await getPublishedArticles()).map((entry) => ({
    params: { slug: entry._sys.breadcrumbs.join('/') },
    props: { relativePath: entry._sys.relativePath },
  }));
}
const { data } = await getArticle(Astro.props.relativePath);
---

<ArticlePage data={data.article} />
---