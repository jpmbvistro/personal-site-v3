---
import RichText from './RichText.astro';
import { tinaField } from '@tinacms/astro';
import type { PageQuery } from '../../tina/__generated__/types';
import ButtonLink from './ButtonLink.astro';
import { safeHref } from '../lib/links';

interface Props {
  data: PageQuery['page'];
  resume?: string | null;
}
const { data, resume } = Astro.props;
const content = data.homepage;
const resumeHref = safeHref(resume);
---

<p class="eyebrow" data-tina-field={tinaField(content, 'eyebrow')}>{content?.eyebrow}</p>
<h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
<div class="prose introduction" data-tina-field={tinaField(data, 'body')}>
  <RichText content={data.body} />
</div>
<div class="hero-actions">
  {content?.primaryAction?.label && safeHref(content.primaryAction.url) && <ButtonLink href={safeHref(content.primaryAction.url)} data-tina-field={tinaField(content.primaryAction, 'label')}>{content.primaryAction.label} <span aria-hidden="true">↗</span></ButtonLink>}
  <a class="resume-action" href={resumeHref || '/contact/'} data-tina-field={tinaField(content, 'resumeLabel')}>{resumeHref ? content?.resumeLabel || 'View résumé' : 'Get in touch'} <span aria-hidden="true">↗</span></a>
</div>

<style>
  .eyebrow { max-width: 38rem; font-size: 0.6875rem; font-family: var(--font-sans); font-weight: 600; letter-spacing: 0.14em; }
  h1 { margin-block: var(--space-6); max-width: 19ch; font-size: clamp(2.625rem, 4.7vw, 4.5rem); line-height: 1.06; letter-spacing: -0.045em; text-wrap: pretty; }
  h1::after { content: ''; display: block; width: 3rem; height: 2px; margin-top: var(--space-6); background: var(--accent); }
  .introduction { max-width: 49ch; color: var(--muted-foreground); font-size: var(--text-body); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); margin-top: var(--space-8); font-size: var(--text-small); }
  .hero-actions span { margin-left: var(--space-3); }
  .resume-action { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; border-bottom: 1px solid var(--border); }
  .resume-action:hover { border-color: var(--primary); }
  @media (max-width: 24rem) { .hero-actions { gap: var(--space-3); } }
</style>
