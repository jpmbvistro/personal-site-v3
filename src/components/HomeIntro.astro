---
import RichText from './RichText.astro';
import { tinaField } from '@tinacms/astro';
import type { PageQuery } from '../../tina/__generated__/types';

interface Props {
  data: PageQuery['page'];
}
const { data } = Astro.props;
---

<p class="eyebrow">Engineering / Leadership</p>
<h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
<div class="prose introduction" data-tina-field={tinaField(data, 'body')}>
  <RichText content={data.body} />
</div>

<style>
  h1 { margin-block: var(--space-6); overflow-wrap: anywhere; }
  .introduction { color: var(--muted-foreground); font-size: var(--text-body); }
</style>
