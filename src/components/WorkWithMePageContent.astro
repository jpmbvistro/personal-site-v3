---
import { tinaField } from '@tinacms/astro';
import type { PageQuery } from '../../tina/__generated__/types';
import RichText from './RichText.astro';
import Container from './Container.astro';
import ButtonLink from './ButtonLink.astro';
import { safeHref } from '../lib/links';

interface Props {
  data: PageQuery['page'];
  portrait?: string | null;
  portraitAlt?: string | null;
  articleLink?: { href: string; label: string } | null;
}
const { data, portrait, portraitAlt, articleLink } = Astro.props;
const w = data.workWithMe;
const hero = w?.hero;
const approach = w?.approach;
const evidence = w?.evidence;
const focus = w?.focus;
const engagements = w?.engagements;
const closing = w?.closing;

const contactFallback = '/contact/';
const heroCandidate = safeHref(hero?.actionUrl);
const heroExternal = !!heroCandidate && /^https:\/\//i.test(heroCandidate);
const heroUrl = heroExternal ? heroCandidate! : contactFallback;
const closingCandidate = safeHref(closing?.actionUrl);
const closingExternal = !!closingCandidate && /^https:\/\//i.test(closingCandidate);
const closingUrl = closingExternal ? closingCandidate! : contactFallback;
const heroLabel = hero?.actionLabel || 'Discuss an initiative';
const closingLabel = closing?.actionLabel || 'Discuss an initiative';

const inquiryCandidate = safeHref(closing?.inquiryUrl);
const inquiryExternal = !!inquiryCandidate && /^https:\/\//i.test(inquiryCandidate);
const inquiryUrl = inquiryExternal ? inquiryCandidate! : undefined;
const inquiryLabel = closing?.inquiryLabel?.trim() || undefined;
const showInquiry = !!inquiryLabel && !!inquiryUrl;

const approachRows = [approach?.see, approach?.decide, approach?.leadStage]
  .map((row, index) => ({ row, number: String(index + 1).padStart(2, '0') }))
  .filter((item) => item.row);

const engagementRows = [engagements?.assessment, engagements?.transformation, engagements?.embedded]
  .map((row, index) => ({ row, number: String(index + 1).padStart(2, '0') }))
  .filter((item) => item.row);

const evidenceCards = [
  { card: evidence?.teams, link: '/work/scaling-ux-capability/', linkLabel: 'View UX enablement case study' },
  { card: evidence?.delivery, link: '/work/ai-assisted-delivery/', linkLabel: 'View AI delivery case study' },
  { card: evidence?.featured, link: '/work/nonprofit-crm-selection/', linkLabel: 'View CRM selection case study' },
].filter((item) => item.card);

const focusItems = [focus?.engineering, focus?.ai].filter(Boolean);
---

<section class="hero" aria-labelledby="work-with-me-hero">
  <Container>
    <div class="hero-copy">
      {hero?.eyebrow && <p class="eyebrow hero-eyebrow" data-tina-field={tinaField(hero, 'eyebrow')}>{hero.eyebrow}</p>}
      <h1 id="work-with-me-hero" data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
      {hero?.tagline && <p class="hero-tagline" data-tina-field={tinaField(hero, 'tagline')}>{hero.tagline}</p>}
      <div class="hero-body prose" data-tina-field={tinaField(data, 'body')}>
        <RichText content={data.body} />
      </div>
      {articleLink && <p class="hero-article-link">I wrote more about this perspective in <a href={articleLink.href}>{articleLink.label}</a>.</p>}
      <div class="hero-actions">
        <ButtonLink
          href={heroUrl}
          variant="primary"
          target={heroExternal ? '_blank' : undefined}
          rel={heroExternal ? 'noopener noreferrer' : undefined}
          aria-label={heroExternal ? `${heroLabel} (opens in new tab)` : undefined}
          data-tina-field={tinaField(hero, 'actionLabel')}
        >
          {heroLabel} {heroExternal && <span aria-hidden="true">↗</span>}
        </ButtonLink>
        <a class="hero-secondary-link" href="#selected-experience">See selected experience <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="hero-media">
      <video
        class="hero-video"
        src="/uploads/work-with-me/constellation-hero.mp4"
        poster="/uploads/work-with-me/constellation-poster.webp"
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      <button type="button" class="hero-video-control" data-video-control aria-label="Pause background video">Pause</button>
    </div>
  </Container>
</section>

{approach && <section class="approach" aria-labelledby="approach-heading">
  <Container>
    <div class="approach-copy">
      {approach.eyebrow && <p class="eyebrow" data-tina-field={tinaField(approach, 'eyebrow')}>{approach.eyebrow}</p>}
      <h2 id="approach-heading" data-tina-field={tinaField(approach, 'title')}>{approach.title}</h2>
      {approach.lead && <p class="approach-lead" data-tina-field={tinaField(approach, 'lead')}>{approach.lead}</p>}
      {approach.supporting && <p class="approach-supporting" data-tina-field={tinaField(approach, 'supporting')}>{approach.supporting}</p>}
    </div>
    <ol class="approach-rows">
      {approachRows.map(({ row, number }, index) => {
        const titleParts = (row?.title || '').split(/\s*[—–-]\s*/);
        const stageName = titleParts[0]?.trim() || '';
        const stageHeadline = titleParts.slice(1).join(' — ').trim();
        return row && <li>
          <span class="approach-number" aria-hidden="true">{number}</span>
          <div class="row-copy">
            <p class="stage-name">{stageName}</p>
            {stageHeadline && <h3 data-tina-field={tinaField(row, 'title')}>{stageHeadline}</h3>}
            {row.text && <p data-tina-field={tinaField(row, 'text')}>{row.text}</p>}
          </div>
          {index < approachRows.length - 1 && <span class="approach-connector" aria-hidden="true">→</span>}
        </li>;
      })}
    </ol>
  </Container>
</section>}

{evidence && <section class="evidence" id="selected-experience" aria-labelledby="evidence-heading">
  <Container>
    <div class="section-intro">
      {evidence.eyebrow && <p class="eyebrow" data-tina-field={tinaField(evidence, 'eyebrow')}>{evidence.eyebrow}</p>}
      <h2 id="evidence-heading" data-tina-field={tinaField(evidence, 'title')}>{evidence.title}</h2>
      {evidence.intro && <p class="section-lead" data-tina-field={tinaField(evidence, 'intro')}>{evidence.intro}</p>}
    </div>
    <div class="evidence-layout">
      {evidenceCards.length > 0 && (() => {
        const featured = evidenceCards[0];
        const featuredCard = featured.card;
        if (!featuredCard) return null;
        const featuredValue = featuredCard.value || '';
        const [featuredNumber, ...featuredUnit] = featuredValue.split(' ');
        return <article class="evidence-featured evidence-card">
          <p class="card-label" data-tina-field={tinaField(featuredCard, 'label')}>{featuredCard.label}</p>
          <p class="featured-metric">
            <span class="featured-metric-number">{featuredNumber}</span>
            <span class="featured-metric-unit">{featuredUnit.join(' ')}</span>
          </p>
          <h3 data-tina-field={tinaField(featuredCard, 'title')}>{featuredCard.title}</h3>
          {featuredCard.text && <p data-tina-field={tinaField(featuredCard, 'text')}>{featuredCard.text}</p>}
          <a class="card-link" href={featured.link}>{featured.linkLabel} <span aria-hidden="true">↗</span></a>
        </article>;
      })()}
      <div class="evidence-supporting">
        {evidenceCards.slice(1).map(({ card, link, linkLabel }) => card && <article class="evidence-card evidence-supporting-item">
          <p class="card-label" data-tina-field={tinaField(card, 'label')}>{card.label}</p>
          <p class="card-value" data-tina-field={tinaField(card, 'value')}>{card.value}</p>
          <h3 data-tina-field={tinaField(card, 'title')}>{card.title}</h3>
          {card.text && <p data-tina-field={tinaField(card, 'text')}>{card.text}</p>}
          <a class="card-link" href={link}>{linkLabel} <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </Container>
</section>}

{focus && <section class="focus" aria-labelledby="focus-heading">
  <Container>
    <div class="section-intro">
      {focus.eyebrow && <p class="eyebrow focus-eyebrow" data-tina-field={tinaField(focus, 'eyebrow')}>{focus.eyebrow}</p>}
      <h2 id="focus-heading" data-tina-field={tinaField(focus, 'title')}>{focus.title}</h2>
    </div>
    <div class="focus-grid">
      {focusItems.map((item, index) => {
        const image = index === 0 ? focus?.engineering : focus?.ai;
        const imageSrc = safeHref(image?.image);
        return item && <article class="focus-item">
          {imageSrc && <img
            class="focus-image"
            src={imageSrc}
            alt={image?.imageAlt || ''}
            width="887"
            height="887"
            loading="lazy"
            decoding="async"
            data-tina-field={tinaField(image, 'image')}
          />}
          <p class="focus-label" data-tina-field={tinaField(item, 'label')}>{item.label}</p>
          <h3 data-tina-field={tinaField(item, 'statement')}>{item.statement}</h3>
          {item.text && <p data-tina-field={tinaField(item, 'text')}>{item.text}</p>}
        </article>;
      })}
    </div>
  </Container>
</section>}

{engagements && <section class="engagements" aria-labelledby="engagements-heading">
  <Container>
    <div class="section-intro">
      {engagements.eyebrow && <p class="eyebrow" data-tina-field={tinaField(engagements, 'eyebrow')}>{engagements.eyebrow}</p>}
      <h2 id="engagements-heading" data-tina-field={tinaField(engagements, 'title')}>{engagements.title}</h2>
      {engagements.intro && <p class="section-lead" data-tina-field={tinaField(engagements, 'intro')}>{engagements.intro}</p>}
    </div>
    <ol class="engagement-rows">
      {engagementRows.map(({ row, number }) => row && <li>
        <div class="engagement-identity">
          <span class="engagement-number" aria-hidden="true">{number}</span>
          <h3 data-tina-field={tinaField(row, 'title')}>{row.title}</h3>
          {row.question && <p class="engagement-question" data-tina-field={tinaField(row, 'question')}>{row.question}</p>}
        </div>
        <div class="engagement-scope">
          <p class="scope-label">What I do</p>
          {row.description && <p data-tina-field={tinaField(row, 'description')}>{row.description}</p>}
          <p class="scope-label outcome-label">What you gain</p>
          {row.result && <p class="engagement-result" data-tina-field={tinaField(row, 'result')}>{row.result}</p>}
        </div>
      </li>)}
    </ol>
  </Container>
</section>}

{closing && <section class="closing" aria-labelledby="closing-heading">
  <Container>
    <div class:list={['closing-layout', { 'has-portrait': !!portrait }]}>
      <div class="closing-copy">
        {closing.eyebrow && <p class="eyebrow closing-eyebrow" data-tina-field={tinaField(closing, 'eyebrow')}>{closing.eyebrow}</p>}
        <h2 id="closing-heading" data-tina-field={tinaField(closing, 'title')}>{closing.title}</h2>
        {closing.text && <p class="closing-text" data-tina-field={tinaField(closing, 'text')}>{closing.text}</p>}
        {closing.closingLine && <p class="closing-line" data-tina-field={tinaField(closing, 'closingLine')}>{closing.closingLine}</p>}
        <div class="closing-actions">
          <ButtonLink
            href={closingUrl}
            variant="secondary"
            class="closing-button"
            target={closingExternal ? '_blank' : undefined}
            rel={closingExternal ? 'noopener noreferrer' : undefined}
            aria-label={closingExternal ? `${closingLabel} (opens in new tab)` : undefined}
            data-tina-field={tinaField(closing, 'actionLabel')}
          >
            {closingLabel} {closingExternal && <span aria-hidden="true">↗</span>}
          </ButtonLink>
          {showInquiry && (
            <a
              class="inquiry-link"
              href={inquiryUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${inquiryLabel} (opens in new tab)`}
              data-tina-field={tinaField(closing, 'inquiryLabel')}
            >
              {inquiryLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
      {portrait && <div class="closing-portrait">
        <img src={portrait} alt={portraitAlt || ''} width="800" height="1000" loading="lazy" decoding="async" />
      </div>}
    </div>
  </Container>
</section>}

<script>
  const workWithMeMedia = document.querySelector('.hero-media');
  const workWithMeVideo = workWithMeMedia?.querySelector('video.hero-video') as HTMLVideoElement | null;
  const workWithMeControl = workWithMeMedia?.querySelector('[data-video-control]');
  if (workWithMeVideo && workWithMeControl) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncControl = () => {
      if (workWithMeVideo.paused) {
        workWithMeControl.textContent = 'Play';
        workWithMeControl.setAttribute('aria-label', 'Play background video');
      } else {
        workWithMeControl.textContent = 'Pause';
        workWithMeControl.setAttribute('aria-label', 'Pause background video');
      }
    };
    if (!reducedMotion.matches) {
      workWithMeVideo.play().catch(() => {});
    } else {
      workWithMeVideo.pause();
    }
    workWithMeControl.addEventListener('click', () => {
      if (workWithMeVideo.paused) {
        workWithMeVideo.play().catch(() => {});
      } else {
        workWithMeVideo.pause();
      }
    });
    workWithMeVideo.addEventListener('play', syncControl);
    workWithMeVideo.addEventListener('pause', syncControl);
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) workWithMeVideo.pause();
      else workWithMeVideo.play().catch(() => {});
    });
    syncControl();
  }
</script>

<style>
  .hero {
    --ring: var(--primary-foreground);
    background: #071322;
    color: var(--primary-foreground);
    padding-block: clamp(4rem, 7vw, 7rem);
  }
  .hero :global(.container) { display: grid; gap: clamp(var(--space-8), 4vw, var(--space-12)); }
  @media (min-width: 64rem) {
    .hero :global(.container) { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; }
  }
  .hero-copy { min-width: 0; max-width: 46rem; }
  .hero-eyebrow { color: var(--primary-foreground); opacity: 0.72; letter-spacing: 0.16em; }
  .hero h1 { color: var(--primary-foreground); max-width: 14ch; font-size: clamp(3rem, 2rem + 4vw, 5rem); line-height: 1.02; }
  .hero h1::after { content: ''; display: block; width: 3rem; height: 2px; margin-top: var(--space-6); background: var(--accent); }
  .hero-tagline { margin-top: var(--space-4); font-family: var(--font-serif); font-size: clamp(1.25rem, 1rem + 1vw, 1.5rem); color: var(--primary-foreground); opacity: 0.95; }
  .hero-body { margin-top: var(--space-6); max-width: 42rem; color: var(--primary-foreground); opacity: 0.88; line-height: 1.65; }
  .hero-body :global(p) { color: inherit; }
  .hero-article-link { margin-top: var(--space-4); max-width: 42rem; color: var(--primary-foreground); opacity: 0.88; line-height: 1.65; }
  .hero-article-link a { color: inherit; text-decoration: underline; text-underline-offset: 0.25em; }
  .hero-actions { margin-top: var(--space-8); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); }
  .hero :global(.button-link) { background: var(--primary-foreground); color: var(--primary); border-color: var(--primary-foreground); padding-inline: var(--space-6); }
  .hero :global(.button-link:hover) { background: var(--secondary); color: var(--primary); }
  .hero-secondary-link { color: var(--primary-foreground); opacity: 0.86; text-decoration: underline; text-underline-offset: 0.2em; font-size: var(--text-small); }
  .hero-secondary-link:hover { opacity: 1; }
  .hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1.5rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 55%),
      linear-gradient(135deg, color-mix(in srgb, var(--primary-foreground) 6%, transparent), color-mix(in srgb, var(--accent) 12%, transparent));
    border: 0;
  }
  .hero-video { width: 100%; height: 100%; display: block; object-fit: cover; }
  .hero-video-control {
    position: absolute; right: var(--space-3); bottom: var(--space-3);
    min-height: 2rem; padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--primary-foreground) 30%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--primary) 72%, transparent);
    color: var(--primary-foreground); font-size: 0.8125rem; font-weight: 600; cursor: pointer;
  }

  .approach { padding-block: clamp(4rem, 7vw, 6rem); }
  .approach-copy { max-width: 46rem; }
  .approach-lead, .approach-supporting { margin-top: var(--space-4); color: var(--muted-foreground); line-height: 1.65; }
  .approach-rows {
    list-style: none; margin: clamp(3rem, 5vw, 4rem) 0 0; padding: 0;
    position: relative;
    display: grid; gap: var(--space-8);
  }
  @media (min-width: 64rem) {
    .approach-rows { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
  }
  .approach-rows li {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding-top: 2.5rem;
  }
  .approach-rows li:not(:last-child)::after {
    content: '';
    position: absolute;
    z-index: 0;
    top: 1rem;
    left: 1.25rem;
    width: calc(100% + var(--space-8));
    border-top: 1px solid var(--accent);
    opacity: 0.7;
  }
  .approach-number {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    min-height: 2rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--accent-strong);
    background: var(--background);
  }
  .stage-name {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.5rem);
    line-height: 1.1;
    color: var(--primary);
    margin: 0;
  }
  .row-copy h3 { margin: 0; font-size: 1.125rem; color: var(--muted-foreground); font-weight: 500; }
  .row-copy p { margin-top: var(--space-2); color: var(--muted-foreground); line-height: 1.6; }
  .approach-connector { display: none; }
  @media (max-width: 63.999rem) {
    .approach-rows li {
      position: relative;
      display: flex;
      gap: var(--space-4);
      padding-left: 0;
      padding-top: 0;
      align-items: start;
    }
    .approach-rows li:not(:last-child)::after {
      top: 1.75rem;
      bottom: calc(-1 * var(--space-8) - 0.75rem);
      left: 1.25rem;
      width: 1px;
      border-top: 0;
      border-left: 1px solid var(--accent);
    }
    .approach-number {
      position: static;
      flex: 0 0 auto;
      width: 2.5rem;
      min-height: 1.5rem;
      text-align: center;
      margin-top: 0.25rem;
      background: var(--background);
    }
    .row-copy { flex: 1 1 auto; min-width: 0; }
    .approach-connector { display: none; }
  }

  .evidence { padding-block: clamp(4rem, 7vw, 6rem); border-top: 1px solid var(--border); }
  .section-intro { max-width: 46rem; }
  .section-lead { margin-top: var(--space-4); color: var(--muted-foreground); line-height: 1.65; }
  .evidence-layout {
    display: grid;
    min-width: 0;
    gap: clamp(var(--space-8), 4vw, var(--space-12));
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 64rem) {
    .evidence-layout { grid-template-columns: minmax(0, 0.46fr) minmax(0, 0.54fr); }
  }
  .evidence-featured {
    min-width: 0;
    background: var(--primary);
    color: var(--primary-foreground);
    border-radius: var(--radius);
    padding: clamp(var(--space-6), 3vw, var(--space-12));
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .evidence-featured .card-label { color: var(--primary-foreground); opacity: 1; }
  .featured-metric { margin: 0; display: grid; gap: var(--space-1); }
  .featured-metric-number {
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 8vw, 6rem);
    line-height: 1;
    color: var(--primary-foreground);
  }
  .featured-metric-unit {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--primary-foreground);
    opacity: 1;
  }
  .evidence-featured h3 { margin: 0; font-size: 1.5rem; color: var(--primary-foreground); }
  .evidence-featured > p:not(.card-label, .featured-metric) { color: var(--primary-foreground); opacity: 1; line-height: 1.6; }
  .evidence-featured .card-link { color: var(--primary-foreground); margin-top: var(--space-2); justify-self: start; }
  .evidence-featured .card-link:hover { color: var(--primary-foreground); text-decoration-thickness: 2px; }
  .evidence-featured .card-link:focus-visible { outline-color: var(--primary-foreground); }
  .evidence-supporting { display: grid; min-width: 0; gap: var(--space-8); }
  .evidence-supporting-item {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }
  .evidence-supporting-item:last-child { border-bottom: 0; }
  .card-label { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-foreground); }
  .card-value { font-family: var(--font-serif); font-size: clamp(2.25rem, 3vw, 3rem); line-height: 1.05; color: var(--primary); }
  .evidence-card h3 { margin-top: var(--space-2); font-size: 1.25rem; }
  .evidence-card p { color: var(--muted-foreground); line-height: 1.6; }
  .card-link { margin-top: var(--space-4); font-size: var(--text-small); font-weight: 500; color: var(--primary); text-decoration: underline; text-underline-offset: 0.2em; }

  .focus {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .focus-eyebrow { color: var(--primary-foreground); opacity: 0.72; }
  .focus h2 { color: var(--primary-foreground); }
  .focus-grid { display: grid; gap: clamp(var(--space-8), 4vw, var(--space-12)); margin-top: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 64rem) { .focus-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .focus-item { display: grid; gap: var(--space-4); }
  .focus-image { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: contain; border-radius: 1rem; background: color-mix(in srgb, var(--primary-foreground) 6%, transparent); }
