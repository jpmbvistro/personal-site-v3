---
interface Props { name?: string | null }
const { name = 'teams' } = Astro.props;
---

<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'capacity' ? <>
    <circle cx="16" cy="16" r="11" /><circle cx="16" cy="16" r="6" /><path d="m16 16 10-11 M21 5h5v5" />
  </> : name === 'constraints' ? <>
    <path d="M5 8h22 M5 16h22 M5 24h22" /><circle cx="12" cy="8" r="3" fill="var(--background)" /><circle cx="21" cy="16" r="3" fill="var(--background)" /><circle cx="10" cy="24" r="3" fill="var(--background)" />
  </> : name === 'research' ? <>
    <path d="M6 27V15h5v12 M14 27V9h5v18 M22 27V4h5v23 M4 28h25" />
  </> : name === 'system' ? <>
    <rect x="4" y="5" width="24" height="22" rx="2" /><path d="M4 12h24 M13 12v15 M18 17h5 M18 22h5 M8 8h1 M12 8h1" />
  </> : name === 'learning' ? <>
    <path d="M16 8C12 5 7 5 3 7v18c4-2 9-2 13 1 4-3 9-3 13-1V7c-4-2-9-2-13 1v18 M7 11l5 1 M20 12l5-1 M7 16l5 1 M20 17l5-1" />
  </> : <>
    <circle cx="16" cy="8" r="4" /><circle cx="5" cy="11" r="3" /><circle cx="27" cy="11" r="3" /><path d="M9 28v-6a7 7 0 0 1 14 0v6 M2 27v-6a5 5 0 0 1 5-5 M30 27v-6a5 5 0 0 0-5-5 M13 28v-6 M19 28v-6" />
  </>}
</svg>

<style>svg { display: block; width: 2rem; height: 2rem; flex: none; }</style>
