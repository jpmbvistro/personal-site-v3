---
import { tinaField } from '@tinacms/astro';
import type { PageQuery } from '../../tina/__generated__/types';
import RichText from './RichText.astro';
import Container from './Container.astro';
import AboutIcon from './AboutIcon.astro';
import ClosingBand from './ClosingBand.astro';
import { safeHref } from '../lib/links';

interface Props {
  data: PageQuery['page'];
}
const { data } = Astro.props;
const about = data.about;
const path = about?.path;
const principles = about?.principles;
const building = about?.building;
const next = about?.next;
const closing = about?.closing;
const aboutLinks = (data.links ?? [])
  .filter((link): link is NonNullable<typeof link> => Boolean(link && link.label && safeHref(link.url)));
const buildingFeatures = (building?.features ?? [])
  .map((feature) => ({ ...feature, href: safeHref(feature?.url) }));
// Unset keeps the 40/60 layout; '30-70' widens the content column (64rem+).
const split = (section?: { split?: string | null } | null) =>
  section?.split === '30-70' ? 'about-section--wide' : '';
---

<Container>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow" data-tina-field={tinaField(about, 'eyebrow')}>{about?.eyebrow}</p>
      <h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
      <div class="hero-intro">
        <div class="prose" data-tina-field={tinaField(data, 'body')}><RichText content={data.body} /></div>
      </div>
    </div>
    <div class="hero-portrait" data-tina-field={tinaField(about, 'portrait')}>
      {about?.portrait
        ? <img src={about.portrait} alt={about.portraitAlt || 'Portrait of Juan Vistro'} width="1024" height="906" fetchpriority="high" />
        : <div class="portrait-pending"><svg viewBox="0 0 900 300" fill="none" aria-hidden="true"><path d="M0 260C320 -180 410 500 900 20" stroke="var(--accent)" /></svg><p>Portrait to come</p></div>}
    </div>
  </section>

  {path && <section class:list={['about-section', split(path)]} aria-labelledby="path-heading">
    <div class="section-head">
      <p class="eyebrow" data-tina-field={tinaField(path, 'eyebrow')}>{path.eyebrow}</p>
      <h2 id="path-heading" data-tina-field={tinaField(path, 'title')}>{path.title}</h2>
      {path.summary && <p class="lede" data-tina-field={tinaField(path, 'summary')}>{path.summary}</p>}
    </div>
    <div class="section-content">
      <div class="section-body prose" data-tina-field={tinaField(path, 'paragraphs')}>
        <RichText content={path.paragraphs} />
      </div>
    </div>
    {path.stages && path.stages.length > 0 && <ol class="stages" aria-label="Career stages">
      {path.stages.map((stage) => stage && <li>
        <AboutIcon name={stage.icon} size="stage" />
        <div>
          <h3 data-tina-field={tinaField(stage, 'title')}>{stage.title}</h3>
          <p data-tina-field={tinaField(stage, 'text')}>{stage.text}</p>
        </div>
      </li>)}
    </ol>}
  </section>}

  {principles && <section class:list={['about-section', split(principles)]} aria-labelledby="principles-heading">
    <div class="section-head">
      <p class="eyebrow" data-tina-field={tinaField(principles, 'eyebrow')}>{principles.eyebrow}</p>
      <h2 id="principles-heading" class="statement" data-tina-field={tinaField(principles, 'statement')}>{principles.statement}</h2>
      {principles.intro && <p class="lede" data-tina-field={tinaField(principles, 'intro')}>{principles.intro}</p>}
    </div>
    <div class="section-content">
      {principles.items && principles.items.length > 0 && <dl class="principles-list">
        {principles.items.map((item) => item && <div>
          <dt data-tina-field={tinaField(item, 'title')}><span class="badge"><AboutIcon name={item.icon} size="badge" /></span>{item.title}</dt>
          <dd><div class="principle-text" data-tina-field={tinaField(item, 'text')}><RichText content={item.text} /></div></dd>
        </div>)}
      </dl>}
    </div>
  </section>}

  {building && <section class:list={['about-section', split(building)]} aria-labelledby="building-heading">
    <div class="section-head">
      <p class="eyebrow" data-tina-field={tinaField(building, 'eyebrow')}>{building.eyebrow}</p>
      <h2 id="building-heading" data-tina-field={tinaField(building, 'title')}>{building.title}</h2>
    </div>
    <div class="section-content">
      {buildingFeatures.length > 0 && <div class="feature-grid">
        {buildingFeatures.map((feature) => feature && <article class="feature">
          <AboutIcon name={feature.icon} size="feature" />
          <div class="feature-copy">
            <h3 data-tina-field={tinaField(feature, 'name')}>{feature.name}</h3>
            <div class="feature-text" data-tina-field={tinaField(feature, 'text')}><RichText content={feature.text} /></div>
            {feature.linkLabel && feature.href && <a href={feature.href} data-tina-field={tinaField(feature, 'linkLabel')}>{feature.linkLabel} <span aria-hidden="true">↗</span></a>}
          </div>
        </article>)}
      </div>}
    </div>
  </section>}

  {next && next.title && <section class:list={['about-section', split(next)]} aria-labelledby="next-heading">
    <div class="section-head">
      <p class="eyebrow" data-tina-field={tinaField(next, 'eyebrow')}>{next.eyebrow}</p>
      <h2 id="next-heading" data-tina-field={tinaField(next, 'title')}>{next.title}</h2>
    </div>
    <div class="section-content">
      <div class="section-body prose" data-tina-field={tinaField(next, 'paragraphs')}>
        <RichText content={next.paragraphs} />
      </div>
    </div>
  </section>}
</Container>

{aboutLinks.length > 0 && <Container>
  <ul class="about-links" aria-label="Where to go next">
    {aboutLinks.map((link) => link && <li><a href={safeHref(link.url)} data-tina-field={tinaField(link, 'label')}>{link.label} <span aria-hidden="true">↗</span></a></li>)}
  </ul>
</Container>}

{closing && safeHref(closing.url) && closing.title && <ClosingBand
  id="about-closing"
  title={closing.title}
  text={closing.text}
  label={closing.label}
  url={safeHref(closing.url)}
  field={tinaField(closing, 'title')}
/>}

<style>
  .hero { display: grid; align-items: center; gap: var(--space-12); padding-block: clamp(3rem, 7vw, 6.5rem); }
  .hero-copy { min-width: 0; }
  .hero-intro { max-width: 45ch; margin-top: var(--space-8); color: var(--muted-foreground); font-size: var(--text-body); }
  h1 { margin-block: var(--space-6); max-width: 18ch; font-size: clamp(2.625rem, 4.7vw, 4.5rem); line-height: 1.06; letter-spacing: -0.045em; text-wrap: pretty; }
  h1::after { content: ''; display: block; width: 3rem; height: 2px; margin-top: var(--space-6); background: var(--accent); }
  .hero-portrait { justify-self: center; width: min(100%, 26rem); }
  .hero-portrait img { display: block; width: 100%; height: auto; border-radius: 1.5rem; }
  .portrait-pending {
    display: grid; place-items: center; gap: var(--space-3); min-height: 24rem;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--muted);
    text-align: center;
  }
  .portrait-pending svg { width: 80%; height: 12rem; margin-bottom: var(--space-24); opacity: 0.35; }
  .portrait-pending p { font-family: var(--font-serif); font-size: 1.25rem; color: var(--muted-foreground); }

  .about-section { display: grid; gap: var(--space-6); padding-block: clamp(3.5rem, 6vw, 5.5rem); }
  :is(.about-section + .about-section, .hero + .about-section) { border-top: 1px solid var(--border); }
  .section-head h2 { margin-block: var(--space-4) 0; }
  .section-content { display: grid; gap: var(--space-8); }
  .about-section .eyebrow { margin-top: 0; }
  .statement {
    max-width: 41ch; padding-left: var(--space-6); border-left: 2px solid var(--accent);
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(1.875rem, 3vw, 2.75rem); line-height: 1.25; letter-spacing: -0.02em;
  }
  .lede { max-width: 65ch; margin-top: var(--space-4); color: var(--muted-foreground); }
  .section-body { max-width: var(--reading-width); }
  .section-body :global(strong) { color: var(--primary); }

  .stages { display: grid; gap: var(--space-8); margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .stages li { display: grid; gap: var(--space-4); }
  .stages h3 { margin: 0; }
  .stages p { margin-top: var(--space-2); font-size: var(--text-support); }
  .stages :global(.about-icon.stage) { width: 4.5rem; height: 4.5rem; }
  /* Copper arrows between stacked stages; horizontal when the three
     columns have room for them below the row threshold. */
  .stages li:not(:first-child) { position: relative; --stage-gap: var(--space-8); }
  .stages li:not(:first-child)::before { content: '↓'; position: absolute; inset-inline-start: 2.25rem; top: calc(-0.5 * var(--stage-gap)); transform: translate(-50%, -50%); line-height: 1; color: var(--accent); opacity: 0.8; }

  .principles-list { display: grid; gap: var(--space-8); margin: 0; }
  .principles-list dt { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); font-size: 1.25rem; font-family: var(--font-serif); color: var(--primary); }
  .badge { display: block; width: 3.5rem; height: 3.5rem; }
  .badge :global(.about-icon.badge) { width: 3.5rem; height: 3.5rem; }
  .principles-list dd { margin: var(--space-3) 0 0; }
  .principle-text { color: var(--muted-foreground); font-size: var(--text-support); max-width: 42ch; }
  .principle-text :global(p) { font-size: var(--text-support); margin-top: var(--space-3); }
  .principle-text :global(p:first-child) { margin-top: 0; }

  .feature-grid { display: grid; gap: var(--space-6); margin: 0; }
  .feature {
    display: grid; gap: var(--space-6); padding: var(--space-8);
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--muted);
  }
  .feature :global(.about-icon.feature) { width: 5rem; height: 5rem; }
  .feature h3 { margin: 0; font-size: 1.375rem; }
  .feature-text { color: var(--muted-foreground); font-size: var(--text-support); }
  .feature-text :global(p) { margin-top: var(--space-3); }
  .feature-text :global(p:last-child) { margin-bottom: 0; }
  .feature-text :global(strong) { color: var(--primary); }
  .feature a { display: inline-flex; gap: var(--space-3); margin-top: var(--space-4); padding-block: var(--space-2); font-size: var(--text-small); }

  .about-links { display: flex; flex-wrap: wrap; gap: var(--space-6); list-style: none; margin: 0; padding: var(--space-8) 0; border-top: 1px solid var(--border); }
  .about-links a { display: inline-flex; gap: var(--space-4); padding-block: var(--space-3); min-height: 2.75rem; align-items: center; }

  @media (min-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-8); }
  }
  @media (min-width: 64rem) {
    .about-section { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-12); align-items: start; }
    .about-section.about-section--wide { grid-template-columns: minmax(0, 3fr) minmax(0, 7fr); }
    .stages { grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .stages li:not(:first-child)::before { content: '→'; inset-inline-start: calc(-0.5 * var(--stage-gap)); top: 2.25rem; }
    .principles-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .feature { grid-template-columns: auto minmax(0, 1fr); }
  }
  @media (min-width: 80rem) {
    .stages { gap: var(--space-6); }
    .stages li:not(:first-child) { --stage-gap: var(--space-6); }
    /* The two endeavor cards pair up only above 1280px; 1280 itself stacks. */
    .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stages li:not(:first-child) { --stage-gap: var(--space-6); }
    .stages li { grid-template-columns: auto minmax(0, 1fr); gap: var(--space-6); }
  }
  @media (max-width: 24rem) {
    .stages li { grid-template-columns: 1fr; }
    .stages li:not(:first-child)::before { display: none; }
    .feature { grid-template-columns: 1fr; }
  }</style>
