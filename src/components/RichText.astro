---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import type { TinaMarkdownProps } from '@tinacms/astro';
import MetricStrip from './MetricStrip.astro';

interface Props { content: TinaMarkdownProps['content'] }
const { content } = Astro.props;
---

<TinaMarkdown content={content} components={{ MetricStrip }} />
