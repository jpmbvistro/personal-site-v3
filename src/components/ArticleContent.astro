---
import { tinaField } from '@tinacms/astro';
import type { ArticleQuery } from '../../tina/__generated__/types';
import RichText from './RichText.astro';
import ButtonLink from './ButtonLink.astro';
import { safeHref } from '../lib/links';
import { readingTimeMinutes } from '../lib/reading-time';

interface Props { data: ArticleQuery['article'] }
const { data } = Astro.props;
const links = data.links?.filter((link) => link?.label && safeHref(link.url)) ?? [];
const published = data.publishedAt ? new Date(data.publishedAt) : null;
const updated = data.updatedAt ? new Date(data.updatedAt) : null;
const minutes = readingTimeMinutes(data.body);

// The hero is a separate editorial field, not a body figure or the social card.
const heroSrc = safeHref(data.heroImage);
const portraitSrc = safeHref(data.authorPortrait);
const heroSrcset = heroSrc?.endsWith('.webp') && !heroSrc.endsWith('-640.webp')
  ? `${heroSrc.replace(/\.webp$/, '-640.webp')} 640w, ${heroSrc} 1280w`
  : undefined;
---
<div class="article-story">
  {data.draft !== false && <p class="draft-note">Draft · Local editor preview only. Not published.</p>}
  <header class="article-heading">
    <div class="article-heading-inner">
      <h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
      {data.subtitle && <p class="subtitle" data-tina-field={tinaField(data, 'subtitle')}>{data.subtitle}</p>}
      <p class="byline">
        <a href="/about/">By Juan Vistro</a>
        {published && <time datetime={data.publishedAt}>{published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
        {updated && <span>Updated {updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
        <span>{minutes} min read</span>
      </p>
    </div>
    {heroSrc && <figure class="article-hero" data-tina-field={tinaField(data, 'heroImage')}>
      <img
        src={heroSrc}
        srcset={heroSrcset}
        sizes="(min-width: 75rem) 71rem, 100vw"
        alt={data.heroImageAlt || ''}
        width="1280"
        height="720"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>}
  </header>
  <div class="prose article-body" data-tina-field={tinaField(data, 'body')}><RichText content={data.body} /></div>
  {links.length > 0 && <nav class="article-links" aria-label="Related links" data-tina-field={tinaField(data, 'links')}>
    {links.map((link) => link && <a href={safeHref(link.url)}>{link.label} <span aria-hidden="true">↗</span></a>)}
  </nav>}
  {(data.authorBio || portraitSrc) && <section class="author-bio" aria-label="About the author">
    {portraitSrc && <img
      class="author-portrait"
      src={portraitSrc}
      alt={data.authorPortraitAlt || 'Portrait of Juan Vistro'}
      width="1024"
      height="906"
      loading="lazy"
      decoding="async"
      data-tina-field={tinaField(data, 'authorPortrait')}
    />}
    <div class="author-bio-copy">
      {data.authorBio && <p data-tina-field={tinaField(data, 'authorBio')}>{data.authorBio}</p>}
      <ButtonLink href="/about/" variant="primary">More about Juan Vistro</ButtonLink>
    </div>
  </section>}
</div>

<style>
  .article-heading { margin-top: clamp(var(--space-4), 2.5vw, var(--space-8)); text-align: left; }
  /* A centered editorial heading column; the hero keeps the wider canvas. */
  .article-heading-inner { max-width: 60rem; margin-inline: auto; }
  h1 {
    max-width: 100%;
    margin-top: 0;
    margin-inline: auto;
    font-size: clamp(2.75rem, 1.6rem + 3.2vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .subtitle {
    margin-top: var(--space-6);
    margin-inline: auto;
    max-width: 44ch;
    color: var(--muted-foreground);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    line-height: 1.35;
  }
  .byline {
    margin-top: var(--space-6);
    margin-inline: auto;
    max-width: 46rem;
    justify-content: flex-start;
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }
  .article-hero {
    width: min(100%, 71.25rem);
    margin: clamp(var(--space-8), 4vw, var(--space-12)) auto 0;
  }
  .article-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--muted);
  }
  /* A wide editorial canvas holds the figures, while prose keeps its measure. */
  .article-body.prose { max-width: none; margin-top: clamp(2.5rem, 5vw, var(--space-16)); }
  .article-body :global(:is(p, ul, ol, blockquote, h3, pre, table)) { max-width: 46rem; margin-inline: auto; }
  .article-body :global(:is(p, li)) {
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.7;
  }
  .article-body :global(p + p) { margin-top: var(--space-6); }
  .article-body :global(li + li) { margin-top: var(--space-2); }
  .article-body :global(h2) {
    max-width: 46rem;
    margin-inline: auto;
    text-align: left;
    margin-top: clamp(2.5rem, 4vw, var(--space-12));
    font-size: clamp(1.75rem, 1.35rem + 1vw, 2.5rem);
  }
  .article-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    max-width: 46rem;
    margin: var(--space-8) auto 0;
  }
  .author-bio {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    max-width: 46rem;
    margin: var(--space-12) auto 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .author-portrait {
    display: block;
    width: 5.5rem;
    height: 5.5rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
    object-fit: cover;
    object-position: center top;
  }
  .author-bio-copy p { color: var(--muted-foreground); font-size: 0.9375rem; line-height: 1.6; }
  .author-bio-copy :global(.button-link) { margin-top: var(--space-4); font-size: var(--text-small); }
  @media (max-width: 30rem) {
    .author-bio { grid-template-columns: 4.5rem minmax(0, 1fr); gap: var(--space-4); }
    .author-portrait { width: 4.5rem; height: 4.5rem; }
  }
  .draft-note {
    max-width: 46rem;
    margin: 0 auto var(--space-6);
    border-left: 3px solid var(--accent);
    padding: var(--space-4);
    background: var(--muted);
  }
</style>
