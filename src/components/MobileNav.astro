---
import { buildNavigation } from '../lib/navigation';
import { getPublishedArticles } from '../lib/tina/data';

const hasArticles = (await getPublishedArticles()).length > 0;
const navigation = buildNavigation(hasArticles);

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/'
  ? pathname === '/'
  : pathname === href || pathname.startsWith(href);
---

<details data-mobile-nav>
  <summary>
    Menu
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M3 6h12M3 12h12" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </summary>
  <nav aria-label="Mobile navigation">
    {navigation.map(({ label, href, cta }) => <a href={href} class:list={{ 'nav-cta': cta }} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
  </nav>
</details>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
  if (menu) {
    const summary = menu.querySelector('summary');
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
        // Let native link/fragment navigation move focus to the destination.
      });
    });
    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>

<style>
  details { display: block; }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  details[open] summary { background: var(--secondary); }
  nav {
    position: absolute;
    inset: calc(100% - 1px) 0 auto;
    z-index: 20;
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--gutter);
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }
  a {
    padding: var(--space-3) var(--space-2);
    color: var(--foreground);
    text-decoration: none;
  }
  a:hover { color: var(--primary); background: var(--muted); }
  a[aria-current='page'] { border-inline-start: 2px solid var(--accent-strong); padding-inline-start: calc(var(--space-2) - 2px); font-weight: 600; }
  a.nav-cta {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    margin-top: var(--space-2);
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    color: var(--primary);
    font-weight: 500;
    text-decoration: none;
    padding-inline: var(--space-4);
    transition: background-color 160ms ease, color 160ms ease;
  }
  a.nav-cta:hover { background: var(--primary); color: var(--primary-foreground); text-decoration: none; }
  a.nav-cta[aria-current='page'] {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
    font-weight: 500;
    text-decoration: none;
    border-inline-start: 1px solid var(--primary);
    padding-inline-start: var(--space-4);
  }
  a.nav-cta:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; text-decoration: none; }
  @media (min-width: 48rem) { details { display: none; } }
</style>
