---
import { tinaField } from '@tinacms/astro';
import type { WorkQuery, ProjectQuery } from '../../tina/__generated__/types';
import RichText from './RichText.astro';
import StorySection from './StorySection.astro';
import { safeHref } from '../lib/links';

interface Props { data: WorkQuery['work'] | ProjectQuery['project'] }
const { data } = Astro.props;
const organization = 'organizationLabel' in data ? data.organizationLabel : undefined;
const role = 'role' in data ? data.role : undefined;
const status = 'status' in data ? data.status : undefined;
const organizationField = 'organizationLabel' in data ? tinaField(data, 'organizationLabel') : undefined;
const roleField = 'role' in data ? tinaField(data, 'role') : undefined;
const statusField = 'status' in data ? tinaField(data, 'status') : undefined;
const links = data.links?.filter((link) => link?.label && safeHref(link.url)) ?? [];
const editorial = 'presentation' in data && data.presentation === 'editorial';
const sections = 'sections' in data ? data.sections ?? [] : [];
const sectionsField = 'sections' in data ? tinaField(data, 'sections') : undefined;
---

<div class:list={['entry-story', { 'editorial-story': editorial, 'has-draft': data.draft !== false }]}>
{data.draft !== false && <p class="draft-note">Draft · Local editor preview only. Not published.</p>}
<header class="entry-heading">
  {organization && <p class="eyebrow" data-tina-field={organizationField}>{organization}</p>}
  <h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
  {data.summary && <p class="summary" data-tina-field={tinaField(data, 'summary')}>{data.summary}</p>}
  {role && <p class="entry-meta" data-tina-field={roleField}>{role}</p>}
  {status && <p class="entry-meta" data-tina-field={statusField}>{status}</p>}
  {(data.tags?.length ?? 0) > 0 && <ul class="tags" data-tina-field={tinaField(data, 'tags')}>{data.tags?.map((tag) => tag && <li>{tag}</li>)}</ul>}
</header>
<div class="prose entry-body" data-tina-field={tinaField(data, 'body')}><RichText content={data.body} /></div>
{sections.length > 0 && <div class="entry-sections" data-tina-field={sectionsField}>
  {sections.map((section) => section && <StorySection eyebrow={section.eyebrow ?? undefined} title={section.title ?? ''} layout={section.layout ?? undefined} intro={section.intro} children={section.children} aside={section.aside} />)}
</div>}
{links.length > 0 && <nav class="entry-links" aria-label="Related links" data-tina-field={tinaField(data, 'links')}>
  {links.map((link) => link && <a href={safeHref(link.url)}>{link.label} <span aria-hidden="true">↗</span></a>)}
</nav>}
</div>

<style>
  h1 { max-width: 17ch; margin-top: var(--space-4); font-size: clamp(2.5rem, 1.5rem + 4vw, 5.5rem); overflow-wrap: anywhere; }
  .summary { margin-top: var(--space-6); max-width: 48ch; color: var(--muted-foreground); font-size: var(--text-body); }
  .entry-meta { margin-top: var(--space-4); }
  .entry-body { margin-top: var(--space-12); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); padding: 0; margin-top: var(--space-4); list-style: none; color: var(--muted-foreground); font-size: var(--text-small); }
  .entry-links { display: flex; flex-wrap: wrap; gap: var(--space-6); margin-top: var(--space-8); }
  .entry-links a { padding-block: var(--space-3); }
  .draft-note { margin-bottom: var(--space-6); border-left: 3px solid var(--accent); padding: var(--space-4); background: var(--muted); }
  .editorial-story { --hero-row: 1; --hero-figure-row: 1; display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); column-gap: var(--space-12); }
  .editorial-story.has-draft { --hero-row: 2; --hero-figure-row: 2; }
  .editorial-story .draft-note { grid-column: 1 / -1; grid-row: 1; }
  .editorial-story .entry-heading { grid-column: 1; grid-row: var(--hero-row); padding-block: var(--space-4) var(--space-12); }
  .editorial-story h1 { max-width: 15ch; font-size: clamp(3rem, 4.8vw, 5.5rem); letter-spacing: -0.035em; line-height: 1.02; }
  .editorial-story .summary { max-width: 38ch; }
  .editorial-story .entry-meta { font-size: var(--text-support); }
  .editorial-story .summary::before { content: ''; display: block; width: var(--space-8); border-top: 3px solid var(--accent); margin-bottom: var(--space-6); }
  .editorial-story .tags { font-size: 0.75rem; }
  .editorial-story .entry-body { display: contents; }
  .editorial-story .entry-sections { display: contents; }
  .editorial-story :global(.story-section) { grid-column: 1 / -1; }
  .editorial-story :global(.entry-body > *) { grid-column: 1 / -1; }
  .editorial-story :global(.entry-body > .ux-figure:first-child) { grid-column: 2; grid-row: var(--hero-figure-row); align-self: center; margin-block: var(--space-8) var(--space-12); }
  .editorial-story .entry-links { grid-column: 1 / -1; margin-top: 0; }
  @media (max-width: 60rem) {
    .editorial-story { --hero-figure-row: 2; grid-template-columns: minmax(0, 1fr); }
    .editorial-story.has-draft { --hero-figure-row: 3; }
    .editorial-story .entry-heading { grid-column: 1; padding-bottom: var(--space-4); }
    .editorial-story :global(.entry-body > .ux-figure:first-child) { grid-column: 1; margin-block: var(--space-4) var(--space-8); }
  }
</style>
