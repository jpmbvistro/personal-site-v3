---
import Container from './Container.astro';
import MobileNav from './MobileNav.astro';
import { buildNavigation } from '../lib/navigation';
import { getPublishedArticles } from '../lib/tina/data';

const hasArticles = (await getPublishedArticles()).length > 0;
const navigation = buildNavigation(hasArticles);

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/'
  ? pathname === '/'
  : pathname === href || pathname.startsWith(href);
---

<header>
  <Container class="header-inner">
    <a class="wordmark" href="/" aria-label="Juan Vistro — home">
      <img src="/brand/juan-vistro-horizontal.webp" width="1179" height="490" alt="Juan Vistro" fetchpriority="high" />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map(({ label, href, cta }) => <a href={href} class:list={{ 'nav-cta': cta }} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <MobileNav />
  </Container>
</header>

<style>
  header { position: relative; border-bottom: 1px solid var(--border); }
  header :global(.header-inner) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 5.5rem;
    padding-block: var(--space-3);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  /* The supplied artwork has a white raster canvas; multiply lets the shared
     ivory show through without redrawing the custom letters or faint J layer. */
  .wordmark img { display: block; width: clamp(10rem, 18vw, 13rem); height: auto; mix-blend-mode: multiply; }
  .desktop-nav { display: none; gap: var(--space-8); }
  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--foreground);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .desktop-nav a:hover { color: var(--primary); text-decoration: underline; }
  .desktop-nav a[aria-current='page'] { font-weight: 600; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.4em; }
  .desktop-nav a.nav-cta {
    box-sizing: border-box;
    font-weight: 500;
    color: var(--primary);
    border: 1px solid var(--primary);
    border-radius: var(--radius);
    padding-inline: var(--space-4);
    padding-block: 0;
    min-height: 2.75rem;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .desktop-nav a.nav-cta:hover {
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
  .desktop-nav a.nav-cta[aria-current='page'] {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
    font-weight: 500;
    text-decoration: none;
  }
  .desktop-nav a.nav-cta:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
    text-decoration: none;
  }
  @media (min-width: 48rem) { .desktop-nav { display: flex; } }
</style>
