---
import ArchitectureIcon from './ArchitectureIcon.astro';
interface Phase { title: string; text: string }
interface Execution { title: string; note: string; tickets: string[]; worktree: string; agent: string; tests: string; checks: string }
interface Validation { title: string; commands: string; tests: string; shadowDiff: string; failure: string }
interface Recovery { title: string; failure: string; retry: string; persistent: string; human: string; note: string }
interface Observability { title: string; traces: string; investigation: string; fixes: string; note: string }
interface Props {
  caption: string;
  summary: string;
  proof?: Phase | null;
  scale?: Phase | null;
  intakeTitle: string;
  intakeText: string;
  intakeItems?: string[] | null;
  execution?: Execution | null;
  validation?: Validation | null;
  reviewTitle: string;
  reviewText: string;
  recovery?: Recovery | null;
  observability?: Observability | null;
}
const { caption, summary, proof, scale, intakeTitle, intakeText, intakeItems, execution, validation, reviewTitle, reviewText, recovery, observability } = Astro.props;
const summaryId = `delivery-harness-${crypto.randomUUID()}`;
---

{proof && scale && execution && validation && recovery && observability && <figure class="harness-diagram" aria-label={caption} aria-describedby={summaryId}>
  <div class="delivery-phases">
    <div><strong>{proof.title}</strong><p>{proof.text}</p></div>
    <span aria-hidden="true">→</span>
    <div><strong>{scale.title}</strong><p>{scale.text}</p></div>
  </div>
  <ol class="harness-pipeline" role="list">
    <li class="intake-stage pipeline-stage">
      <img class="stage-art" src="/uploads/agentic-delivery/ticket-stack.webp" sizes="128px" width="320" height="371" loading="lazy" alt="" />
      <h3>{intakeTitle}</h3>
      {(intakeItems?.length ?? 0) > 0 ? <ul class="intake-items" role="list">{intakeItems?.map((item) => <li>{item}</li>)}</ul> : <p>{intakeText}</p>}
      <span class="stage-connector" aria-hidden="true">→</span>
    </li>
    <li class="execution-stage pipeline-stage">
      <h3><span class="execution-symbol"><ArchitectureIcon name="stack" /></span>{execution.title}</h3><p class="lane-note">{execution.note}</p>
      <ul class="ticket-lanes" role="list">{(execution.tickets ?? []).map((ticket) => <li class="ticket-lane">
        <strong class="ticket-name">{ticket}</strong>
        <ol class="lane-steps" role="list">
          <li class="ticket-context">
            <img class="worktree-art" src="/uploads/architecture/worktree-144.webp" srcset="/uploads/architecture/worktree-144.webp 144w, /uploads/architecture/worktree-288.webp 288w" sizes="48px" width="144" height="144" loading="lazy" alt="" />
            <strong>{execution.worktree}</strong><p>{execution.tests}</p>
          </li>
          <li class="ticket-implementation">
            <span class="lane-icon"><ArchitectureIcon name="code" /></span>
            <strong>{execution.agent}</strong>
          </li>
          <li class="ticket-validation">
            <span class="lane-icon"><ArchitectureIcon name="validation" /></span>
            <strong class="required-checks">{execution.checks}</strong>
            <ul role="list"><li>{validation.commands}</li><li>{validation.tests}</li><li>{validation.shadowDiff}</li></ul>
          </li>
        </ol>
      </li>)}</ul>
      <p class="failure-rule"><strong>{validation.title}</strong> {validation.failure}</p>
      <span class="stage-connector" aria-hidden="true">→</span>
    </li>
    <li class="review-stage pipeline-stage"><img class="stage-art" src="/uploads/architecture/pr-cube-144.webp" srcset="/uploads/architecture/pr-cube-144.webp 144w, /uploads/architecture/pr-cube-288.webp 288w" sizes="128px" width="144" height="144" loading="lazy" alt="" /><h3>{reviewTitle}</h3><p>{reviewText}</p></li>
  </ol>
  <!-- These are sibling operational mechanisms, not consecutive ticket stages.
       Separate ports originate beneath execution, never beneath PR handoff. -->
  <div class="operational-paths">
    <svg class="diagnostic-connections" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true"><path d="M450 0v10q0 10-10 10H250q-10 0-10 10v10m-4-6 4 6 4-6M550 0v10q0 10 10 10h190q10 0 10 10v10m-4-6 4 6 4-6" /></svg>
    <section class="recovery-stage pipeline-stage" aria-label={recovery.title}>
      <h3><span class="mechanism-symbol"><ArchitectureIcon name="recovery" /></span>{recovery.title}</h3>
      <ol class="recovery-path" role="list">{[recovery.failure, recovery.retry, recovery.persistent, recovery.human].map((step, index) => <li>{index > 0 && <span aria-hidden="true">→</span>}<strong>{step}</strong></li>)}</ol>
      <p class="recovery-note"><span aria-hidden="true">↶</span> {recovery.note}</p>
    </section>
    <section class="observability-stage pipeline-stage" aria-label={observability.title}>
      <h3><span class="mechanism-symbol"><ArchitectureIcon name="improvement" /></span>{observability.title}</h3>
      <ol class="improvement-path" role="list">{[observability.traces, observability.investigation, observability.fixes].map((step, index) => <li>{index > 0 && <span aria-hidden="true">→</span>}<strong>{step}</strong></li>)}</ol>
      <p>{observability.note}</p>
    </section>
  </div>
  <figcaption>{caption}</figcaption>
  <p class="diagram-summary" id={summaryId}>{summary}</p>
</figure>}

<style>
  .harness-diagram { margin: 0; min-width: 0; }
  .delivery-phases { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-6); align-items: center; margin-bottom: var(--space-8); border-block: 1px solid var(--border); padding-block: var(--space-4); }
  .delivery-phases strong { font: 400 1.5rem/1.2 var(--font-serif); color: var(--primary); }
  .delivery-phases p { margin-top: var(--space-2); font-size: var(--text-support); }
  .delivery-phases > span { color: var(--accent-strong); }
  .harness-pipeline { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 3.5fr) minmax(0, 0.85fr); gap: var(--space-8); margin: 0; padding: 0; list-style: none; }
  .pipeline-stage { position: relative; min-width: 0; }
  .intake-stage, .review-stage { display: flex; flex-direction: column; justify-content: center; padding: var(--space-6) var(--space-4); border: 1px solid var(--border); border-radius: var(--space-6); }
  .stage-art { width: 8rem; height: 8rem; object-fit: contain; margin: 0 auto var(--space-6); }
  .execution-stage { border: 1px solid var(--border); border-radius: var(--space-6); padding: var(--space-6) var(--space-4); background: color-mix(in srgb, var(--primary) 3%, var(--background)); }
  .pipeline-stage h3 { display: flex; align-items: center; gap: var(--space-3); font: 400 1.8rem/1.15 var(--font-serif); margin-top: 0; margin-bottom: var(--space-4); }
  .pipeline-stage p, .pipeline-stage li { font-size: var(--text-annotation); line-height: 1.5; overflow-wrap: anywhere; }
  .pipeline-stage :is(ul, ol) { list-style: none; padding: 0; margin: 0; }
  .pipeline-stage strong { font-weight: 500; color: var(--primary); }
  .execution-symbol { flex: 0 0 2rem; height: 2rem; color: var(--primary); }
  .intake-items { display: grid; gap: var(--space-3); }
  .intake-items > li { position: relative; padding-left: var(--space-3); }
  .intake-items > li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); }
  .stage-connector { position: absolute; left: calc(100% + var(--space-2)); top: 50%; width: var(--space-4); text-align: center; color: var(--accent-strong); }
  .ticket-lanes { display: grid; gap: var(--space-4); }
  .lane-note { margin-bottom: var(--space-4); }
  .ticket-lane { display: grid; grid-template-columns: 5.25rem minmax(0, 1fr); gap: var(--space-3); border: 1px solid var(--border); border-radius: var(--space-3); background: var(--background); }
  .ticket-name { display: grid; align-items: center; padding: var(--space-2); border-radius: var(--space-3) 0 0 var(--space-3); background: color-mix(in srgb, var(--primary) 8%, var(--background)); font-family: var(--font-serif); font-size: 1.2rem; white-space: nowrap; }
  .pipeline-stage .lane-steps { padding: var(--space-3) var(--space-3) var(--space-3) 0; }
  .lane-steps { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.35fr); gap: var(--space-6); }
  .lane-steps > li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: var(--space-2); align-content: center; position: relative; min-width: 0; }
  .lane-steps > li + li::before { content: '→'; position: absolute; right: calc(100% + var(--space-1)); top: 50%; color: var(--accent-strong); }
  .lane-icon, .worktree-art { display: block; grid-row: 1 / 3; width: 3rem; height: 3rem; object-fit: contain; align-self: center; }
  .lane-icon { padding: var(--space-2); color: var(--primary); background: color-mix(in srgb, var(--primary) 8%, var(--background)); border-radius: var(--space-3); }
  .worktree-art { max-width: none; }
  .lane-steps strong { display: block; grid-column: 2; font: 500 1.1rem/1.2 var(--font-serif); }
  .lane-steps :is(p, ul) { grid-column: 2; }
  .lane-steps p, .ticket-validation ul { margin-top: var(--space-2); }
  .ticket-validation ul { display: grid; gap: var(--space-1); }
  .ticket-validation ul > li { padding-left: var(--space-2); border-left: 1px solid var(--border); }
  .failure-rule { margin-top: var(--space-4); border-left: 2px solid var(--accent); padding-left: var(--space-3); }
  .failure-rule strong { display: block; margin-bottom: var(--space-1); }
  .operational-paths { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); margin-top: var(--space-12); }
  .diagnostic-connections { position: absolute; bottom: 100%; width: 100%; height: var(--space-12); fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 2 3; }
  .recovery-stage, .observability-stage { padding: var(--space-6); border: 1px dashed var(--accent); border-radius: var(--space-6); }
  .mechanism-symbol { flex: 0 0 3rem; height: 3rem; padding: var(--space-2); border: 1px solid var(--border); border-radius: 50%; color: var(--accent-strong); background: color-mix(in srgb, var(--accent) 6%, var(--background)); }
  .recovery-path, .improvement-path { display: flex; gap: var(--space-3); }
  .recovery-path > li, .improvement-path > li { position: relative; display: grid; flex: 1; align-items: center; min-width: 0; border-radius: var(--space-3); padding: var(--space-3); background: color-mix(in srgb, var(--primary) 5%, var(--background)); text-align: center; }
  .recovery-path > li:last-child { background: color-mix(in srgb, var(--accent) 8%, var(--background)); }
  .recovery-path span, .improvement-path span { position: absolute; right: 100%; width: var(--space-3); color: var(--accent-strong); }
  .recovery-stage p, .observability-stage p { margin-top: var(--space-4); }
  figcaption { margin-top: var(--space-8); color: var(--primary); font: 400 1.5rem/1.3 var(--font-serif); }
  .diagram-summary { margin-top: var(--space-2); max-width: 90ch; font-size: var(--text-support); }
  @media (max-width: 70rem) {
    .harness-pipeline { grid-template-columns: minmax(0, 1fr); gap: var(--space-8); }
    .intake-stage, .review-stage { display: grid; grid-template-columns: 6rem minmax(0, 1fr); column-gap: var(--space-4); align-items: center; }
    .stage-art { grid-row: 1 / 3; margin: 0; width: 6rem; height: 6rem; }
    .intake-stage h3, .review-stage h3 { margin-bottom: var(--space-2); }
    .stage-connector { top: calc(100% + var(--space-2)); left: 50%; transform: rotate(90deg); line-height: 1; }
    .diagnostic-connections { display: none; }
    .operational-paths { grid-template-columns: minmax(0, 1fr); }
  }
  @media (min-width: 40.001rem) and (max-width: 60rem) {
    /* Preserve whole words on tablets: retain independent horizontal lanes,
       but give each step its full column rather than squeezing text by icons. */
    .lane-steps > li { display: block; }
    .lane-icon, .worktree-art { width: 2.5rem; height: 2.5rem; margin-bottom: var(--space-2); }
    .lane-steps > li + li::before { top: 1rem; }
  }
  @media (max-width: 40rem) {
    .delivery-phases { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .delivery-phases > span { justify-self: center; transform: rotate(90deg); line-height: 1; }
    .ticket-lane { grid-template-columns: minmax(0, 1fr); padding: var(--space-4); border-left: 2px solid var(--accent); }
    .ticket-name { margin-bottom: var(--space-2); border-radius: var(--space-2); }
    .pipeline-stage .lane-steps { padding: 0; }
    .lane-steps { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
    .lane-steps > li { grid-template-columns: 2.5rem minmax(0, 1fr); min-height: 3rem; }
    .lane-steps > li + li { border-top: 1px solid var(--border); padding-top: var(--space-4); }
    .lane-steps > li + li::before { content: '↓'; right: auto; left: 1rem; top: calc(-1 * var(--space-3)); line-height: 1; }
    .lane-icon, .worktree-art { width: 2.5rem; height: 2.5rem; }
    .recovery-path, .improvement-path { flex-direction: column; }
    .recovery-path span, .improvement-path span { top: calc(-1 * var(--space-3)); right: 50%; transform: rotate(90deg); line-height: 1; }
    .intake-stage, .review-stage, .execution-stage, .recovery-stage, .observability-stage { padding: var(--space-4); border-radius: var(--space-4); }
    .intake-stage, .review-stage { grid-template-columns: 4rem minmax(0, 1fr); }
    .stage-art { width: 4rem; height: 4rem; }
    .pipeline-stage h3 { font-size: 1.5rem; }
  }
</style>
