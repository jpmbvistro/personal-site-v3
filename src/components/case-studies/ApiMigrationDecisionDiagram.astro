---
interface ScopeGate {
  label: string;
  title: string;
  backlog: string;
  traffic: string;
  consumers: string;
  criteria: string;
  question: string;
  no: string;
  removedValue: string;
  removedLabel: string;
  yes: string;
  retained: string;
}
interface BehaviorGate {
  label: string;
  title: string;
  superseded: string;
  typedClient: string;
  rejectedReason: string;
  legacy: string;
  proxy: string;
  comparison: string;
  discrepancies: string;
  question: string;
  mismatch: string;
  investigation: string;
  branches: string;
  correction: string;
  rerun: string;
  match: string;
  passed: string;
  ci: string;
  ciDetail: string;
}
interface Props {
  caption: string;
  summary: string;
  scope?: ScopeGate | null;
  behavior?: BehaviorGate | null;
}
const { caption, summary, scope, behavior } = Astro.props;
---

<!-- One semantic composition, reflowed rather than shrinking SVG text on mobile.
     Text and DOM order carry every relationship; all connectors are decorative. -->
{scope && behavior && <figure class="api-decision-diagram" aria-label={caption}>
  <div class="two-gates">
    <section class="gate scope-gate" aria-label={scope.label}>
      <header><p class="gate-label">{scope.label}</p><h3>{scope.title}</h3></header>
      <ul class="evidence" role="list">
        <li><span aria-hidden="true">≡</span>{scope.backlog}</li>
        <li><span aria-hidden="true">↗</span>{scope.traffic}</li>
        <li><span aria-hidden="true">◎</span>{scope.consumers}</li>
        <li><span aria-hidden="true">✓</span>{scope.criteria}</li>
      </ul>
      <div class="down" aria-hidden="true">↓</div>
      <p class="question"><span class="junction" aria-hidden="true"></span>{scope.question}</p>
      <div class="scope-branches">
        <div class="scope-exit">
          <p class="branch-label"><span aria-hidden="true">↙</span> {scope.no}</p>
          <p class="removed-result"><strong>{scope.removedValue}</strong><span>{scope.removedLabel}</span></p>
        </div>
        <div class="scope-retain">
          <p class="branch-label"><span aria-hidden="true">↘</span> {scope.yes}</p>
          <p>{scope.retained}</p>
        </div>
      </div>
    </section>
    <div class="retained-bridge" aria-hidden="true">
      <svg viewBox="0 0 80 500" preserveAspectRatio="none" aria-hidden="true"><path d="M0 450C65 450 15 25 80 25M72 21l8 4-8 4" vector-effect="non-scaling-stroke" /></svg>
      <span>↓</span>
    </div>
    <section class="gate behavior-gate" aria-label={behavior.label}>
      <header><p class="gate-label">{behavior.label}</p><h3>{behavior.title}</h3></header>
      <div class="superseded">
        <p class="assumption-label"><span aria-hidden="true">×</span> {behavior.superseded}</p>
        <p><s>{behavior.typedClient}</s></p>
        <p>{behavior.rejectedReason}</p>
      </div>
      <div class="trusted-inputs"><p>{behavior.legacy}</p><span aria-hidden="true">⇄</span><p>{behavior.proxy}</p></div>
      <div class="down" aria-hidden="true">↓</div>
      <div class="comparison"><strong>{behavior.comparison}</strong><p>{behavior.discrepancies}</p></div>
      <div class="down" aria-hidden="true">↓</div>
      <p class="question"><span class="junction" aria-hidden="true"></span>{behavior.question}</p>
      <div class="behavior-branches">
        <div class="mismatch-path">
          <p class="branch-label"><span aria-hidden="true">↙</span> {behavior.mismatch}</p>
          <div class="investigation"><strong>{behavior.investigation}</strong><p class="branch-finding">{behavior.branches}</p><p>{behavior.correction}</p></div>
          <p class="rerun"><span aria-hidden="true">↶</span> {behavior.rerun}</p>
          <!-- This return line terminates beside the comparison, not at CI/pass. -->
          <svg class="feedback-loop" viewBox="0 0 20 300" preserveAspectRatio="none" aria-hidden="true"><path d="M18 295H8Q2 295 2 285V15Q2 5 8 5H18M13 0l5 5-5 5" /></svg>
        </div>
        <div class="match-path"><p class="branch-label"><span aria-hidden="true">↘</span> {behavior.match}</p><p>{behavior.passed}</p></div>
      </div>
      <div class="ci-outcome"><span aria-hidden="true">↻</span><div><strong>{behavior.ci}</strong><p>{behavior.ciDetail}</p></div></div>
    </section>
  </div>
  <figcaption>{caption}</figcaption>
  <p class="diagram-summary">{summary}</p>
</figure>}

<style>
  .api-decision-diagram { margin: 0; min-width: 0; }
  .two-gates { display: grid; grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr); }
  .gate { min-width: 0; padding: var(--space-6); border: 1px solid var(--border); border-radius: var(--radius); }
  .gate header { margin-bottom: var(--space-6); }
  .scope-gate { display: flex; flex-direction: column; }
  .scope-gate .evidence { flex: 1; align-content: space-evenly; }
  .gate-label { color: var(--accent-strong); font: 400 0.8125rem/1.6 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; }
  h3 { margin-top: var(--space-2); font: 400 clamp(1.7rem, 2.4vw, 2.2rem)/1.12 var(--font-serif); }
  .gate p, .gate li { font-size: var(--text-annotation); line-height: 1.5; overflow-wrap: anywhere; }
  .gate strong { font-weight: 500; color: var(--primary); }
  .gate .gate-label { font-size: 0.8125rem; }
  .evidence { display: grid; gap: var(--space-3); padding: 0; margin: 0; list-style: none; }
  .evidence li { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-3); border: 1px solid var(--border); }
  .evidence li > span { flex: 0 0 1.5rem; text-align: center; color: var(--primary); font-size: 1.25rem; }
  .down { text-align: center; color: var(--primary); line-height: 1; margin-block: var(--space-3); }
  .gate .question { position: relative; border-block: 1px solid var(--accent); padding: var(--space-4) var(--space-3); text-align: center; color: var(--primary); font-size: 1rem; font-weight: 500; }
  .junction { position: absolute; left: 50%; top: -4px; width: 7px; height: 7px; border: 1px solid var(--accent); border-radius: 50%; background: var(--background); }
  .scope-branches, .behavior-branches { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-4); }
  .branch-label { margin-block: var(--space-3); font-weight: 600; color: var(--primary); }
  .removed-result { border-left: 2px solid var(--accent); padding-left: var(--space-3); }
  .removed-result strong { display: block; font: 400 2.6rem/1.1 var(--font-serif); }
  .removed-result span { display: block; margin-top: var(--space-2); }
  .scope-retain > p:last-child { padding: var(--space-3); border: 1px solid var(--primary); }
  /* The continuation originates at the Yes path, not the shared question or No exit.
     Equal-height panels keep the fixed illustration lane outside editable text.
     It enters Gate 2's heading, never the superseded input or the CI outcome. */
  .retained-bridge { align-self: stretch; position: relative; }
  .retained-bridge svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .retained-bridge > span { display: none; }
  .superseded { border-left: 2px dashed var(--accent); padding-left: var(--space-3); margin-bottom: var(--space-6); }
  .superseded p + p { margin-top: var(--space-1); }
  .assumption-label { color: var(--accent-strong); font-weight: 500; }
  .trusted-inputs { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: var(--space-2); align-items: center; text-align: center; }
  .trusted-inputs p { padding: var(--space-3); border: 1px solid var(--border); }
  .comparison { border: 1px solid var(--primary); padding: var(--space-3); text-align: center; }
  .comparison p { margin-top: var(--space-2); }
  .mismatch-path { position: relative; padding-left: var(--space-4); }
  .investigation { border-left: 2px solid var(--accent); padding-left: var(--space-3); }
  .investigation p { margin-top: var(--space-2); }
  .branch-finding { font-weight: 500; }
  .rerun { margin-top: var(--space-3); font-weight: 500; }
  .feedback-loop { position: absolute; top: -10rem; left: -0.5rem; width: 1rem; height: calc(100% + 10rem); fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .match-path > p:last-child { border: 1px solid var(--border); padding: var(--space-3); }
  .ci-outcome { display: flex; gap: var(--space-3); border-top: 1px solid var(--primary); margin-top: var(--space-6); padding-top: var(--space-4); }
  .ci-outcome > span { font-size: 2rem; line-height: 1; color: var(--primary); }
  .ci-outcome p { margin-top: var(--space-2); }
  figcaption { margin-top: var(--space-6); color: var(--primary); font: 400 1.5rem/1.3 var(--font-serif); }
  .diagram-summary { margin-top: var(--space-2); max-width: 90ch; font-size: var(--text-support); }
  @media (max-width: 60rem) {
    .two-gates { grid-template-columns: minmax(0, 1fr); }
    .scope-gate .evidence { flex: initial; }
    .gate { padding: var(--space-6); }
    .retained-bridge { display: grid; place-items: center; height: var(--space-12); }
    .retained-bridge svg { display: none; }
    .retained-bridge > span { display: block; color: var(--primary); font-size: 1.5rem; }
  }
  @media (max-width: 30rem) {
    .gate { padding: var(--space-4); }
    .scope-branches, .behavior-branches { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .scope-exit { padding-bottom: var(--space-3); border-bottom: 1px solid var(--border); }
    .trusted-inputs { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .trusted-inputs > span { line-height: 1; }
    .feedback-loop { top: -9.5rem; height: calc(100% + 9.5rem); }
    .gate .question { text-align: left; }
  }
</style>
