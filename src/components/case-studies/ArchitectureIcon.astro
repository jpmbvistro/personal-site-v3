---
interface Props {
  name: 'stack' | 'traffic' | 'applications' | 'criteria' | 'code' | 'proxy' | 'comparison' | 'branches' | 'validation' | 'recovery' | 'improvement';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'stack' || name === 'improvement' ? <path d="m3 10 13-7 13 7-13 7ZM3 16l13 7 13-7M3 22l13 7 13-7" />
    : name === 'traffic' ? <path d="M4 28V17h5v11m5 0V10h5v18m5 0V4h5v24M2 28h28" />
    : name === 'applications' ? <><circle cx="16" cy="8" r="4" /><circle cx="5" cy="12" r="3" /><circle cx="27" cy="12" r="3" /><path d="M9 28v-7a7 7 0 0 1 14 0v7ZM2 27v-6a5 5 0 0 1 5-5m23 11v-6a5 5 0 0 0-5-5" /></>
    : name === 'criteria' ? <><path d="M10 6H6v23h20V6h-4M11 3h10v6H11ZM10 19l4 4 8-9" /></>
    : name === 'code' ? <path d="m10 8-7 8 7 8m12-16 7 8-7 8M19 4l-6 24" />
    : name === 'proxy' ? <path d="m4 9 12-6 12 6-12 6ZM4 9v15l12 6 12-6V9M16 15v15" />
    : name === 'comparison' ? <><path d="M11 3h10m-8 0v10L5 27q-1 2 2 2h18q3 0 2-2l-8-14V3M9 21h14" /><path d="M11 25h10" /></>
    : name === 'branches' ? <><circle cx="16" cy="5" r="3" /><circle cx="5" cy="26" r="3" /><circle cx="27" cy="26" r="3" /><path d="M16 8v9M5 23v-2q0-4 5-4h12q5 0 5 4v2" /></>
    : name === 'validation' ? <path d="m16 3 12 5v9q-1 8-12 13Q5 25 4 17V8ZM10 16l4 4 8-9" />
    : <path d="M27 12a12 12 0 0 0-21-4L3 12m0-8v8h8M5 20a12 12 0 0 0 21 4l3-4m0 8v-8h-8" />}
</svg>

<style>svg { display: block; width: 100%; height: 100%; }</style>
