---
interface Props {
  caption: string;
  summary: string;
  necessity: string;
  correctness: string;
}
const { caption, summary, necessity, correctness } = Astro.props;
---

<figure class="lead-figure api-preview">
  <div class="preview-questions">
    <!-- A quiet shared motif, not a connector from one inquiry to the other. -->
    <svg class="ribbon" viewBox="0 0 400 260" preserveAspectRatio="none" aria-hidden="true"><path d="M0 25C210 -20 160 245 400 200L400 225C150 270 170 50 0 50Z" /></svg>
    <div class="preview-question">
      <svg class="question-symbol" viewBox="0 0 48 48" aria-hidden="true"><path d="M7 11h34L28 27v11l-8-4v-7ZM12 6h24" /><circle cx="24" cy="27" r="2" /></svg>
      <strong>{necessity}</strong>
    </div>
    <div class="preview-question">
      <svg class="question-symbol" viewBox="0 0 48 48" aria-hidden="true"><path d="M37 15A17 17 0 1 0 40 29M37 6v9H28M17 24h14M24 17v14" /><circle cx="24" cy="24" r="2" /></svg>
      <strong>{correctness}</strong>
    </div>
  </div>
  <figcaption>{caption}</figcaption>
  <p class="diagram-summary">{summary}</p>
</figure>

<style>
  .api-preview { min-width: 0; margin: 0; }
  .preview-questions { position: relative; display: grid; gap: var(--space-12); padding-block: var(--space-8); }
  .ribbon { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--accent); fill-opacity: 0.07; }
  .preview-question { position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: center; gap: var(--space-4); padding: var(--space-3); border: 1px solid var(--border); background: var(--background); border-radius: var(--radius); }
  .preview-question:nth-of-type(2) { margin-left: var(--space-8); }
  .question-symbol { width: 3rem; height: 3rem; fill: var(--background); stroke: var(--accent-strong); stroke-width: 1.1; }
  strong { font-size: var(--text-support); line-height: 1.5; font-weight: 500; }
  figcaption { margin-top: var(--space-4); color: var(--primary); font: 400 1.5rem/1.2 var(--font-serif); }
  .diagram-summary { margin-top: var(--space-2); font-size: var(--text-support); }
  @media (max-width: 60rem) { .preview-questions { max-width: 28rem; margin-inline: auto; } }
  @media (max-width: 30rem) { .preview-question:nth-of-type(2) { margin-left: 0; } }
</style>
