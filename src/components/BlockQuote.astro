---
interface Props { label?: string | null; quote: string; attribution?: string | null; originalThought?: boolean | null }
const { label, quote, attribution, originalThought = false } = Astro.props;
const TextContainer = originalThought ? 'div' : 'blockquote';
---

{quote && <figure class="story-quote">
  {label && <p class="quote-label eyebrow">{label}</p>}
  <TextContainer class="quote-text"><p>{quote}</p></TextContainer>
  {!originalThought && attribution && <figcaption>{attribution}</figcaption>}
</figure>}

<style>
  .story-quote { margin: 0; padding-left: var(--space-6); border-left: 1px solid var(--accent); }
  .quote-label { margin-bottom: var(--space-4); color: var(--accent-strong); }
  .quote-text { margin: 0; padding: 0; border: 0; }
  .quote-text p { color: var(--primary); font: italic 300 clamp(1.5rem, 2vw, 2rem)/1.3 var(--font-serif); }
  figcaption { margin-top: var(--space-4); color: var(--muted-foreground); font: 600 var(--text-support, var(--text-body))/1.6 var(--font-sans); }
</style>
