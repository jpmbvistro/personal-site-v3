---
import { safeHref } from '../lib/links';

interface Props {
  image?: string | null;
  alt?: string | null;
  caption?: string | null;
  width?: number;
  height?: number;
}
const { image, alt, caption, width = 1280, height = 720 } = Astro.props;
const src = safeHref(image);
// Derivatives ship at 1280px and 640px; width/height carry each asset's real
// intrinsic ratio so the layout reservation matches the supplied artwork.
const srcset = src?.endsWith('.webp') && !src.endsWith('-640.webp')
  ? `${src.replace(/\.webp$/, '-640.webp')} 640w, ${src} 1280w`
  : undefined;
---

{src && <figure class="article-figure">
  <img
    src={src}
    srcset={srcset}
    sizes="(min-width: 60rem) 56rem, 100vw"
    alt={alt || ''}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>}

<style>
  .article-figure {
    margin-block: clamp(var(--space-8), 4vw, var(--space-12));
    margin-inline: auto;
    width: min(100%, 56rem);
    min-width: 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--muted);
  }
  figcaption {
    margin-top: var(--space-3);
    text-align: center;
    color: var(--muted-foreground);
    font-size: var(--text-small);
    line-height: 1.5;
  }
</style>
