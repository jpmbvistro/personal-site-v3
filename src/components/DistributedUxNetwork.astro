---
import StoryIcon from './StoryIcon.astro';
import EditorialCallouts from './EditorialCallouts.astro';

interface Props {
  caption: string;
  summary: string;
  specialistsLabel: string;
  resourcesLabel: string;
  participantsLabel: string;
  teamsLabel: string;
  calloutsLabel?: string | null;
  callouts?: ({ icon?: string | null; title: string; text?: string | null } | null)[] | null;
}
const { caption, summary, specialistsLabel, resourcesLabel, participantsLabel, teamsLabel, calloutsLabel, callouts } = Astro.props;
// Fixed geometry describes this particular initiative, not a CMS graph editor.
const teams = Array.from({ length: 12 }, (_, index) => ({
  x: 38 + index * 49.4,
  y: 540 + Math.sin((index / 11) * Math.PI) * 42,
}));
---

<figure class="ux-figure ux-network">
  <div class:list={['figure-composition', { 'with-callouts': (callouts?.length ?? 0) > 0 }]}>
    <div class="diagram-main">
      <div class="diagram-desktop">
        <!-- Ribbons are decorative; the separate connector layer expresses relationships. -->
        <div class="network-topology">
          <svg class="ribbon-layer" viewBox="0 0 620 650" aria-hidden="true">
            <path d="M15 140 C240 160 95 400 580 615 C360 550 170 320 15 140Z" />
            <path d="M605 140 C380 160 525 400 40 615 C260 550 450 320 605 140Z" />
            <ellipse cx="310" cy="260" rx="185" ry="220" />
            <ellipse cx="310" cy="260" rx="235" ry="160" transform="rotate(-35 310 260)" />
          </svg>
          <svg class="structural-connections" viewBox="0 0 620 650" aria-hidden="true">
            <path d="M310 180V255 M100 240C150 245 195 270 220 310" />
            {teams.map(({ x, y }) => <path d={`M310 425 C310 475 ${x} 480 ${x} ${y}`} />)}
            {teams.map(({ x, y }) => <circle class="team-node" cx={x} cy={y} r="7" />)}
          </svg>
          <div class="source-specialists"><StoryIcon /><strong>{specialistsLabel}</strong></div>
          <div class="source-resources"><StoryIcon name="learning" /><span>{resourcesLabel}</span></div>
          <div class="embedded"><StoryIcon /><strong>{participantsLabel}</strong></div>
          <p class="teams-label">{teamsLabel}</p>
        </div>
      </div>

      <!-- Mobile is deliberately vertical, never a scaled desktop radial figure. -->
      <div class="diagram-mobile">
        <div class="mobile-guidance"><StoryIcon /><strong>{specialistsLabel}</strong><span>{resourcesLabel}</span></div>
        <span class="flow-arrow" aria-hidden="true">↓</span>
        <div class="mobile-participants"><StoryIcon /><strong>{participantsLabel}</strong></div>
        <span class="flow-arrow" aria-hidden="true">↓</span>
        <div class="mobile-teams"><div class="team-dots" aria-hidden="true">{teams.map(() => <span />)}</div><strong>{teamsLabel}</strong></div>
      </div>
    </div>
    {(callouts?.length ?? 0) > 0 && <div class="hero-outcomes">
      <EditorialCallouts label={calloutsLabel} items={callouts} />
    </div>}
  </div>
  <figcaption>{caption}</figcaption>
  <p class="diagram-summary">{summary}</p>
</figure>

<style>
  .ux-figure { position: relative; margin: 0; min-width: 0; container-type: inline-size; }
  .figure-composition { display: grid; align-items: center; gap: var(--space-4); }
  .with-callouts { grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr); }
  .diagram-main, .hero-outcomes { min-width: 0; }
  .diagram-desktop { position: relative; isolation: isolate; }
  .network-topology { position: relative; aspect-ratio: 620 / 650; }
  .ribbon-layer, .structural-connections { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ribbon-layer { fill: var(--primary); opacity: 0.08; }
  .ribbon-layer path + path { fill: var(--accent); }
  .ribbon-layer ellipse { fill: none; stroke: var(--primary); stroke-width: 1; stroke-dasharray: 2 5; }
  .structural-connections { fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .team-node { fill: var(--background); stroke-width: 2; }
  .source-specialists, .embedded { position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); text-align: center; background: var(--background); border: 1px solid var(--accent); border-radius: 50%; padding: var(--space-3); }
  .source-specialists { width: 38%; height: 28%; top: 0; left: 31%; }
  .source-resources { position: absolute; left: 0; top: 29%; width: 27%; display: grid; justify-items: center; gap: var(--space-2); text-align: center; font-size: var(--text-small); line-height: 1.4; }
  strong { color: var(--primary); font-weight: 500; font-size: 1rem; line-height: 1.35; }
  .embedded { width: 44%; height: 27%; top: 39%; left: 28%; }
  .teams-label { position: absolute; bottom: 0; width: 100%; text-align: center; font-size: var(--text-small); font-weight: 500; color: var(--primary); }
  .hero-outcomes :global(.editorial-callouts) { grid-template-columns: 1fr; gap: var(--space-6); }
  .hero-outcomes :global(.editorial-callouts > li) { border: 0; padding: 0; }
  .hero-outcomes :global(h3) { font-size: 1.2rem; }
  .hero-outcomes :global(p) { font-size: 0.8rem; }
  .hero-outcomes :global(.callout-icon) { width: 2.75rem; height: 2.75rem; margin-bottom: calc(var(--space-2) / 3); }
  figcaption { margin-top: var(--space-6); font-family: var(--font-serif); color: var(--primary); font-size: 1.4rem; line-height: 1.3; }
  .diagram-summary { margin-top: var(--space-2); color: var(--muted-foreground); font-size: var(--text-small); line-height: 1.6; }
  .flow-arrow { color: var(--primary); font-size: 1.5rem; text-align: center; }
  .team-dots { display: grid; grid-template-columns: repeat(4, 0.65rem); gap: var(--space-2); justify-content: center; }
  .team-dots span { width: 0.65rem; height: 0.65rem; border: 1.5px solid var(--primary); border-radius: 50%; background: var(--background); }
  .diagram-mobile { display: none; }
  @container (max-width: 36rem) {
    .with-callouts { grid-template-columns: 1fr; }
    .network-topology { max-width: 30rem; margin-inline: auto; }
    .hero-outcomes :global(.editorial-callouts) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 48rem) {
    .diagram-desktop { display: none; }
    .diagram-mobile { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); padding-block: var(--space-4); }
    .mobile-guidance, .mobile-participants, .mobile-teams { display: grid; justify-items: center; gap: var(--space-3); width: 100%; padding: var(--space-4); border: 1px solid var(--border); text-align: center; border-radius: var(--radius); }
    .mobile-guidance span { font-size: var(--text-small); }
    .hero-outcomes :global(.editorial-callouts) { grid-template-columns: 1fr; }
    .hero-outcomes :global(li) { display: flex; gap: var(--space-4); }
    .hero-outcomes :global(.callout-icon) { flex: none; }
    figcaption { margin-top: var(--space-4); }
  }
</style>
