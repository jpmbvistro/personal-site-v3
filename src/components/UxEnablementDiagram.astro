---
interface Props {
  composition?: string;
  caption: string;
  summary: string;
  specialistsLabel: string;
  resourcesLabel: string;
  participantsLabel: string;
  teamsLabel: string;
}
const { composition = 'network', caption, summary, specialistsLabel, resourcesLabel, participantsLabel, teamsLabel } = Astro.props;
// This figure describes one specific 12-team initiative, not an editable graph.
// Positions and connectors belong to Astro; all displayed language belongs to Tina.
const teams = Array.from({ length: 12 }, (_, index) => ({
  x: 38 + index * 49.4,
  y: 410 + Math.sin((index / 11) * Math.PI) * 40,
}));
---

<figure class:list={['ux-figure', `ux-${composition === 'approach' ? 'approach' : 'network'}`]}>
  <div class="diagram-desktop">
    <!-- Decorative ribbons are intentionally separate from the actual connections. -->
    <svg class="ribbon-layer" viewBox="0 0 620 510" aria-hidden="true">
      <path d="M20 130 C100 205 155 300 310 284 C192 330 115 227 20 130Z" />
      <path d="M600 130 C520 205 465 300 310 284 C428 330 505 227 600 130Z" />
    </svg>
    {composition !== 'approach' ? <div class="network-topology">
      <svg class="structural-connections" viewBox="0 0 620 510" aria-hidden="true">
        <path d="M155 130 C155 190 310 160 310 225 M465 130 C465 190 310 160 310 225" />
        {teams.map(({ x, y }) => <path d={`M310 310 C310 365 ${x} 350 ${x} ${y}`} />)}
        {teams.map(({ x, y }) => <circle cx={x} cy={y} r="7" />)}
      </svg>
      <div class="source source-specialists"><span class="node-mark" aria-hidden="true">◎</span><strong>{specialistsLabel}</strong></div>
      <div class="source source-resources"><span class="node-mark" aria-hidden="true">◇</span><strong>{resourcesLabel}</strong></div>
      <div class="embedded"><span class="node-mark" aria-hidden="true">◎ ◎</span><strong>{participantsLabel}</strong></div>
      <p class="teams-label">{teamsLabel}</p>
    </div> : <div class="approach-topology">
      <div class="approach-guidance"><strong>{specialistsLabel}</strong><span>{resourcesLabel}</span></div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="approach-participants"><strong>{participantsLabel}</strong></div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="approach-teams"><div class="team-dots" aria-hidden="true">{teams.map(() => <span />)}</div><strong>{teamsLabel}</strong></div>
    </div>}
  </div>

  <!-- A separate vertical composition, not a scaled-down radial diagram. -->
  <div class="diagram-mobile">
    <div class="mobile-guidance"><strong>{specialistsLabel}</strong><span>{resourcesLabel}</span></div>
    <span class="flow-arrow" aria-hidden="true">↓</span>
    <div class="mobile-participants"><strong>{participantsLabel}</strong></div>
    <span class="flow-arrow" aria-hidden="true">↓</span>
    <div class="mobile-teams"><div class="team-dots" aria-hidden="true">{teams.map(() => <span />)}</div><strong>{teamsLabel}</strong></div>
  </div>
  <figcaption>{caption}</figcaption>
  <p class="diagram-summary">{summary}</p>
</figure>

<style>
  .ux-figure { position: relative; margin: 0; min-width: 0; }
  .diagram-desktop { position: relative; isolation: isolate; }
  .ribbon-layer { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; fill: var(--primary); opacity: 0.055; pointer-events: none; }
  .ribbon-layer path + path { fill: var(--accent); }
  .network-topology { position: relative; aspect-ratio: 620 / 510; }
  .structural-connections { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: var(--accent); stroke-width: 1.4; }
  .structural-connections circle { fill: var(--background); stroke-width: 2; }
  .source, .embedded { position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2); text-align: center; background: var(--background); border: 1px solid var(--border); border-radius: 50%; padding: var(--space-3); }
  .source { width: 37%; height: 30%; top: 0; }
  .source strong { font-size: clamp(0.85rem, 1.2vw, 1.05rem); }
  .source-specialists { left: 6.5%; }
  .source-resources { right: 6.5%; }
  strong { color: var(--primary); font-weight: 500; font-size: 1.05rem; line-height: 1.35; }
  .node-mark { color: var(--primary); font-size: 1.35rem; line-height: 1; }
  .embedded { width: 45%; height: 27%; top: 37%; left: 27.5%; }
  .teams-label { position: absolute; bottom: 0; width: 100%; text-align: center; font-weight: 500; color: var(--primary); }
  figcaption { margin-top: var(--space-6); font-family: var(--font-serif); color: var(--primary); font-size: 1.4rem; line-height: 1.3; }
  .diagram-summary { margin-top: var(--space-2); color: var(--muted-foreground); font-size: var(--text-small); line-height: 1.6; }
  .approach-topology { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: var(--space-3); align-items: center; padding-block: var(--space-8); }
  .approach-guidance, .approach-participants, .approach-teams { display: flex; flex-direction: column; gap: var(--space-3); text-align: center; }
  .approach-guidance span { font-size: var(--text-small); }
  .flow-arrow { color: var(--primary); font-size: 1.5rem; text-align: center; }
  .team-dots { display: grid; grid-template-columns: repeat(4, 0.65rem); gap: var(--space-2); justify-content: center; }
  .team-dots span { width: 0.65rem; height: 0.65rem; border: 1.5px solid var(--primary); border-radius: 50%; }
  .diagram-mobile { display: none; }
  @media (max-width: 48rem) {
    .diagram-desktop { display: none; }
    .diagram-mobile { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); padding-block: var(--space-4); }
    .mobile-guidance, .mobile-participants, .mobile-teams { width: 100%; padding: var(--space-4); border: 1px solid var(--border); text-align: center; border-radius: var(--radius); }
    .mobile-guidance span { display: block; margin-top: var(--space-2); font-size: var(--text-small); }
    .team-dots { margin-bottom: var(--space-3); }
    figcaption { margin-top: var(--space-4); }
  }
</style>
