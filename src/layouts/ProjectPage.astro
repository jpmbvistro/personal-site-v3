---
import type { ProjectQuery } from '../../tina/__generated__/types';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import EntryContent from '../components/EntryContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '../lib/tina/islands';

interface Props { data: ProjectQuery['project']; preview?: boolean }
const { data, preview = false } = Astro.props;
---

<BaseLayout title={`${data.title} — Juan Vistro`} description={data.summary || data.title} noindex={preview}>
  <Container class="detail-page">
    <a class="back-link" href="/projects/">← All projects</a>
    <TinaIsland name="project" wrapper={islands.project.wrapper} params={{ path: data._sys.relativePath, ...(preview ? { preview: '1' } : {}) }} primary>
      <EntryContent data={data} />
    </TinaIsland>
    <div class="next-path"><a href="/work/">Explore professional work →</a><a href="/about/">About Juan →</a></div>
  </Container>
</BaseLayout>
