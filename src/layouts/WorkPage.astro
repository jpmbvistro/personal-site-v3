---
import type { WorkQuery } from '../../tina/__generated__/types';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import EntryContent from '../components/EntryContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '../lib/tina/islands';

interface Props { data: WorkQuery['work']; preview?: boolean }
const { data, preview = false } = Astro.props;
---

<BaseLayout title={`${data.title} — Juan Vistro`} description={data.summary || data.title} noindex={preview} editorial={data.presentation === 'editorial'}>
  <Container class="detail-page">
    <a class="back-link" href="/work/">← All work</a>
    <TinaIsland name="work" wrapper={islands.work.wrapper} params={{ path: data._sys.relativePath, ...(preview ? { preview: '1' } : {}) }} primary>
      <EntryContent data={data} />
    </TinaIsland>
    <div class="next-path"><a href="/projects/">Explore projects →</a><a href="/contact/">Get in touch →</a></div>
  </Container>
</BaseLayout>

<style>
  /* Give these diagram-led stories room for relationships and align the shared
     shell with their canvas. Other Work entries keep the original measure. */
  :global(body:has(.api-decision-diagram, .harness-diagram, .crm-transformation)) {
    --content-width: var(--content-width-wide);
  }
</style>
