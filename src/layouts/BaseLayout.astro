---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  editorial?: boolean;
  ogType?: string;
  ogTitle?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const {
  title,
  description,
  noindex = false,
  editorial = false,
  ogType = 'website',
  ogTitle,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  imageType,
  jsonLd,
} = Astro.props;
const excludeFromIndex = noindex || !Astro.site;
// Never canonicalize a preview or carry query strings/edit state into metadata.
const canonical = !excludeFromIndex && Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;
const siteOrigin = Astro.site?.origin || import.meta.env.SITE_URL || 'https://juanvistro.com';
const absoluteImage = image
  ? (image.startsWith('http') ? image : new URL(image, siteOrigin).href)
  : undefined;
const resolvedOgTitle = ogTitle || title;
const resolvedImageType = imageType || (absoluteImage?.endsWith('.png') ? 'image/png' : absoluteImage?.endsWith('.jpg') || absoluteImage?.endsWith('.jpeg') ? 'image/jpeg' : absoluteImage?.endsWith('.webp') ? 'image/webp' : undefined);
const twitterCard = absoluteImage ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {excludeFromIndex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Juan Vistro" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && resolvedImageType && <meta property="og:image:type" content={resolvedImageType} />}
    {absoluteImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {absoluteImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {absoluteImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {absoluteImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {canonical && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta name="theme-color" content="#F3EDE3" />
    <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'editorial-work': editorial }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>

<style>
  body { min-height: 100svh; display: flex; flex-direction: column; }
  main { flex: 1; }
</style>
