---
import type { ArticleQuery } from '../../tina/__generated__/types';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import ArticleContent from '../components/ArticleContent.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { islands } from '../lib/tina/islands';

interface Props { data: ArticleQuery['article']; preview?: boolean }
const { data, preview = false } = Astro.props;

const seo = (data.seo ?? {}) as any;
const title = seo.title || `${data.title} — Juan Vistro`;
const description = seo.description || data.summary || data.title;
const ogTitle = data.title;
const image = seo.socialImage || undefined;
const imageAlt = seo.socialImageAlt || undefined;

const siteOrigin = Astro.site?.origin || import.meta.env.SITE_URL || 'https://juanvistro.com';
const absoluteImage = image ? (image.startsWith('http') ? image : new URL(image, siteOrigin).href) : undefined;

const publishedAt = data.publishedAt || undefined;
const updatedAt = data.updatedAt || undefined;

// Canonical, og:url and JSON-LD must all name the same live article route.
// While SITE_URL is unset there is no canonical origin, so none is emitted.
const canonicalUrl = Astro.site && !preview && data.draft === false
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description,
  author: { '@type': 'Person', name: 'Juan Vistro' },
  ...(canonicalUrl ? { url: canonicalUrl, mainEntityOfPage: canonicalUrl } : {}),
  ...(absoluteImage ? { image: absoluteImage } : {}),
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(updatedAt ? { dateModified: updatedAt } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  noindex={preview || data.draft !== false}
  ogType="article"
  ogTitle={ogTitle}
  image={absoluteImage}
  imageAlt={imageAlt}
  imageWidth={seo.socialImageWidth || undefined}
  imageHeight={seo.socialImageHeight || undefined}
  imageType={seo.socialImageType || undefined}
  jsonLd={jsonLd}
>
  <Container class="detail-page">
    <a class="back-link" href="/articles/">← All articles</a>
    <TinaIsland name="article" wrapper={islands.article.wrapper} params={{ path: data._sys.relativePath, ...(preview ? { preview: '1' } : {}) }} primary>
      <ArticleContent data={data} />
    </TinaIsland>
  </Container>
</BaseLayout>
---