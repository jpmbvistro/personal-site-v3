# Copy to .env.local or set in the build environment for TinaCloud builds.
# Local development needs no credentials.
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
TINA_PUBLIC_BRANCH=main

# Leave unset for local QA and Vercel previews (noindex; no sitemap/canonical).
# Set only for the chosen public origin when ready; this does not change DNS.
SITE_URL=
